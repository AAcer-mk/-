import math
AUTO='shutdown --cluster argon --confirm --operator=lin_wu'
PREFIX='shutdown --cluster arg'
MANUAL='shutdown --cluster argon --confirm'
def events():
    manual=[.35+i*.112 for i in range(len(PREFIX))]
    automatic=[3.15+i*.062 for i in range(len(AUTO)-len(PREFIX))]
    retype=[.65+i*(5.10/(len(MANUAL)-1)) for i in range(len(MANUAL))]
    return {'manual_prefix':manual,'automatic_tail':automatic,'manual_retype':retype,'delete_at':.35,'lever_absolute':611.6}
def text_at(shot,t):
    e=events()
    if shot=='F6-01':
        n=sum(t>=x for x in e['manual_prefix'])
        if t>=3.15:n=len(PREFIX)+sum(t>=x for x in e['automatic_tail'])
        return AUTO[:n]
    if t<.35:return AUTO
    return MANUAL[:sum(t>=x for x in e['manual_retype'])]
def finger_phase(t):
    # Slow key travel plus a restrained involuntary tremor.
    return .5+.5*math.sin((t-.65)/(5.10/(len(MANUAL)-1))*math.pi)
