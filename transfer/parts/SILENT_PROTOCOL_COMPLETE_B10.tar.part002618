import pathlib,subprocess,os,json,hashlib
import numpy as np
from scipy.signal import butter,sosfilt
import resume_control as c
from f6_actions import events
from verify_encoded_silence import measure
ROOT=c.ROOT;SR=48000;e=events();rng=np.random.default_rng(6109)
source=ROOT/json.loads((ROOT/'project/audio_working_selection.json').read_text())['path']
target=ROOT/'output/SILENT_PROTOCOL_MIX_SCENE_REVIEW_B10_v1_18M15S.flac'
stem=ROOT/'audio/derived_stems/F6_authored_B10_v1.wav'
if target.exists() or stem.exists():raise FileExistsError('Use a new revision; do not overwrite')
t=np.arange(25*SR)/SR;room=(.0028*np.sin(2*np.pi*60*t)+.0018*np.sin(2*np.pi*38*t))
room[t>=21.6]*=.74
mix=np.column_stack([room,room]).astype(np.float32)
keyevents=[]
def key(at,gain,heavy=False):
    u=np.arange(round(SR*.045))/SR
    a=sosfilt(butter(2,[450,9200],btype='bandpass',fs=SR,output='sos'),rng.normal(size=len(u)))*np.exp(-u*150)
    if heavy:a+=.45*np.sin(2*np.pi*210*u)*np.exp(-u*110)
    a=a/max(abs(a))*gain;pos=round(at*SR);mix[pos:pos+len(a)]+=np.column_stack([a,a])
    keyevents.append({'local':at,'global':590+at,'sample':pos,'heavy':heavy})
for at in e['manual_prefix']:key(at,.085)
for at in e['automatic_tail']:key(at,.065)
key(14+e['delete_at'],.12,True)
for at in e['manual_retype']:key(14+at,.14,True)
# Original procedural breath texture, no human voice or cloned recording.
for at in [10.0,17.1]:
    u=np.arange(round(SR*.85))/SR
    breath=sosfilt(butter(2,[280,2500],btype='bandpass',fs=SR,output='sos'),rng.normal(size=len(u)))
    breath*=np.sin(np.pi*u/.85)**2*.0022
    pos=round(at*SR);mix[pos:pos+len(breath)]+=breath[:,None]
lever=ROOT/'audio/derived_stems/lever_05_rt60_1.12s.wav'
raw=subprocess.check_output(['ffmpeg','-nostdin','-v','error','-xerror','-i',str(lever),'-f','f32le','pipe:1'])
click=np.frombuffer(raw,dtype='<f4').reshape(-1,2);pos=round(21.6*SR);mix[pos:pos+len(click)]+=click
command=['ffmpeg','-nostdin','-v','error','-f','f32le','-ar',str(SR),'-ac','2','-i','pipe:0','-c:a','pcm_s24le',str(stem)]
subprocess.run(command,input=mix.astype('<f4').tobytes(),check=True)
with stem.open('rb') as f:os.fsync(f.fileno())
a,b=590*SR,615*SR
filter=f'[0:a]asplit=2[pre][post];[pre]atrim=end_sample={a},asetpts=PTS-STARTPTS[A];[1:a]asetpts=PTS-STARTPTS[B];[post]atrim=start_sample={b},asetpts=PTS-STARTPTS[C];[A][B][C]concat=n=3:v=0:a=1[out]'
command=['ffmpeg','-nostdin','-v','error','-i',str(source),'-i',str(stem),'-filter_complex',filter,'-map','[out]','-c:a','flac','-sample_fmt','s32','-bits_per_raw_sample','24',str(target)]
subprocess.run(command,check=True)
with target.open('rb') as f:os.fsync(f.fileno())
def pcmhash(p,start,end):
    proc=subprocess.Popen(['ffmpeg','-nostdin','-v','error','-xerror','-i',str(p),'-af',f'atrim=start_sample={start}:end_sample={end}','-f','s32le','pipe:1'],stdout=subprocess.PIPE)
    h=hashlib.sha256();size=0
    while block:=proc.stdout.read(4*1024*1024):h.update(block);size+=len(block)
    if proc.wait():raise RuntimeError('PCM decode failed')
    return {'sha256':h.hexdigest(),'bytes':size}
before=[pcmhash(source,0,a),pcmhash(target,0,a)];after=[pcmhash(source,b,1095*SR),pcmhash(target,b,1095*SR)]
assert before[0]==before[1] and after[0]==after[1]
ending=measure(target,977.5,983.5);wall=measure(target,564.4583333333333,572.9583333333333)
assert ending['all_zero'] and wall['all_zero']
decode=subprocess.run(['ffmpeg','-nostdin','-v','error','-xerror','-i',str(target),'-f','null','-'],capture_output=True,text=True);assert decode.returncode==0
probe=json.loads(subprocess.check_output(['ffprobe','-v','error','-show_format','-show_streams','-of','json',str(target)]));assert abs(float(probe['format']['duration'])-1095)<.001
report={'status':'WORK_MIX_NOT_FINAL','source':str(source.relative_to(ROOT)),'source_sha256':c.sha(source),'output':str(target.relative_to(ROOT)),'sha256':c.sha(target),'bytes':target.stat().st_size,'duration':1095,'full_decode_exit':decode.returncode,'F6_stem':str(stem.relative_to(ROOT)),'F6_stem_sha256':c.sha(stem),'key_events':keyevents,'lever_global':611.6,'lever_original_stem_sha256':c.sha(lever),'lever_rt60':1.12,'outside_F6_bit_exact':True,'E5_06':wall,'END_03':ending,'peak':float(abs(mix).max()),'method':'Seeded original synthesis; same protected lever fifth stem; no voices cloned; film-wide listening/sync remains pending','actual_build_command':command}
