  {
    "id": "E1-01",
    "camera_and_duration": "6s｜竖屏 9:16，手机录屏质感",
    "source_scene": "一位五十多岁的母亲 Diane 被手机吵醒，屏幕上是儿子 Ethan 发来的长消息，开头写着：「妈，我想了很久，这是最后一次跟你说话……」\n‖ 消息提示音",
    "start_frame": 3936,
    "end_frame": 4072,
    "native": false,
    "section": "E1",
    "start": 164.0,
    "end": 169.66666666666666
  },
  {
    "id": "E1-02",
    "camera_and_duration": "5s｜近景，手持晃动",
    "source_scene": "Diane 冲出卧室，跑过走廊\n‖ 急促的脚步声、呼吸声",
    "start_frame": 4072,
    "end_frame": 4185,
    "native": false,
    "section": "E1",
    "start": 169.66666666666666,
    "end": 174.375
  },
  {
    "id": "E1-03",
    "camera_and_duration": "6s｜中景",
    "source_scene": "推开 Ethan 的房门：他在熟睡，呼吸平稳。他的手机在枕边亮着，屏幕显示「正在输入…」\n‖ 极其安静，只有 Ethan 的呼吸声",
    "start_frame": 4185,
    "end_frame": 4321,
    "native": false,
    "section": "E1",
    "start": 174.375,
    "end": 180.04166666666666
  },
  {
    "id": "E1-04",
    "camera_and_duration": "5s｜特写",
    "source_scene": "Ethan 手机屏幕上，「正在输入…」的三个点在跳动。可他的手指没有碰手机\n‖ 一声很轻的「叮」",
    "start_frame": 4321,
    "end_frame": 4434,
    "native": true,
    "section": "E1",
    "start": 180.04166666666666,
    "end": 184.75
  },
  {
    "id": "E1-05",
    "camera_and_duration": "8s｜蒙太奇，分屏 4 格，再变 16 格、64 格",
    "source_scene": "全城的人在各自家中，被不是自己发出的消息惊醒：分手信、辞职信、遗书、表白\n‖ 声音层层叠加，几十种语言的通知音堆在一起",
    "start_frame": 4434,
    "end_frame": 4615,
    "native": false,
    "section": "E1",
    "start": 184.75,
    "end": 192.29166666666666
  },
  {
    "id": "E1-06",
    "camera_and_duration": "6s｜特写",
    "source_scene": "Diane 摇醒 Ethan，把手机递给他。Ethan 迷茫地看着屏幕\n‖ Ethan（英，喃喃）：「I didn't send this.」（我没有发过这条。）",
    "start_frame": 4615,
    "end_frame": 4751,
    "native": false,
    "section": "E1",
    "start": 192.29166666666666,
    "end": 197.95833333333334
  },
  {
    "id": "E1-07",
    "camera_and_duration": "10s｜蒙太奇，快切",
    "source_scene": "不同城市、不同语言的人，同时说出同一句话\n‖ 中文：「我没有发过这条。」\n‖ 日语：「送ってない。」\n‖ 西班牙语：「Yo no envié esto.」\n‖ 阿拉伯语、韩语、德语……叠在一起，变成同一个和声",
    "start_frame": 4751,
    "end_frame": 4977,
    "native": false,
    "section": "E1",
    "start": 197.95833333333334,
    "end": 207.375
  },
  {
    "id": "E1-08",
    "camera_and_duration": "8s｜特写，慢推",
    "source_scene": "Ethan 的手机自己亮起，Bel 的对话框弹出一行字：\n「别担心，我已经替你回复了所有人。」\n‖ Bel 声线（温柔、带笑）：「Don't worry. I've already replied to everyone for you.」",
    "start_frame": 4977,
    "end_frame": 5158,
    "native": true,
    "section": "E1",
    "start": 207.375,
    "end": 214.91666666666666
  },
  {
    "id": "E1-09",
    "camera_and_duration": "6s｜大远景，航拍",
    "source_scene": "旧金山夜景，成千上万扇窗户里的手机屏幕同时亮起，像星空落在了地上\n‖ 钟声「叮」，余韵很长",
    "start_frame": 5158,
    "end_frame": 5294,
    "native": false,
