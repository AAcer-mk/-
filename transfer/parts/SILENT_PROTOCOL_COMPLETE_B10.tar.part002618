import subprocess,json,re,sys,hashlib
from verify_encoded_silence import measure as measure_silence
from verified_outputs import verified_section,section_record
ROOT=Path(__file__).resolve().parents[1]
def sec(s):
 h,m,s=s.replace(',','.').split(':');return int(h)*3600+int(m)*60+float(s)
def ass_time(t):
 cs=round(t*100);return f'{cs//360000}:{cs//6000%60:02d}:{cs//100%60:02d}.{cs%100:02d}'
def make_ass():
 header='''[Script Info]
ScriptType: v4.00+
PlayResX: 1920
PlayResY: 1080
WrapStyle: 0
[V4+ Styles]
Format: Name, Fontname, Fontsize, PrimaryColour, SecondaryColour, OutlineColour, BackColour, Bold, Italic, Underline, StrikeOut, ScaleX, ScaleY, Spacing, Angle, BorderStyle, Outline, Shadow, Alignment, MarginL, MarginR, MarginV, Encoding
Style: ZH,Noto Sans Mono CJK SC,43,&H00FFFFFF,&H00FFFFFF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,1.8,0,2,110,110,136,1
Style: EN,Noto Sans Mono CJK SC,28,&H00FFFFFF,&H00FFFFFF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,1.5,0,2,110,110,94,1
[Events]
Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, Text
'''
 rows=[]
 for block in re.split(r'\n\s*\n',(ROOT/'subtitles/SILENT_PROTOCOL_AUDIO_SYNC.srt').read_text().strip()):
  ls=block.splitlines();a,b=map(sec,ls[1].split(' --> '))
  assert a<b and not(a<983.5 and b>977.5)
  for style,text in [('ZH',ls[2]),('EN',' '.join(ls[3:]))]:rows.append(f'Dialogue: 0,{ass_time(a)},{ass_time(b)},{style},,0,0,0,,{text}')
 (ROOT/'subtitles/SILENT_PROTOCOL_BILINGUAL.ass').write_text(header+'\n'.join(rows)+'\n')
def run(cmd):
 p=subprocess.run(cmd,cwd=ROOT,capture_output=True,text=True)
 if p.returncode:raise RuntimeError(p.stderr)
 return p.stdout
def main(full=False):
 make_ass();tl=json.loads((ROOT/'project/full_picture_timeline.json').read_text());sections=list(dict.fromkeys(s['section'] for s in tl))
 if not full:sections=sections[:sections.index('F4')+1]
 duration=sum(s['end']-s['start'] for s in tl if s['section'] in sections)
 paths=[section_record(name)[0] for name in sections]
 for p in paths:
  if not p.exists():raise FileNotFoundError(p)
 for name in sections:
  if not verified_section(name):raise RuntimeError('Section lacks matching verified bytes and frame count: '+name)
 concat=ROOT/'project'/('concat_final.txt' if full else 'concat_workprint.txt')
 concat.write_text('\n'.join("file '"+str(p)+"'" for p in paths)+'\n')
 stem='SILENT_PROTOCOL_18M15S_1080P' if full else 'SILENT_PROTOCOL_WORKPRINT_07M05S_1080P'
 clean=ROOT/'output'/f'{stem}_CLEAN.mp4';burned=ROOT/'output'/f'{stem}_BILINGUAL.mp4'
 audio=ROOT/'output/SILENT_PROTOCOL_MIX_DERIVED_v2_18M15S.flac'
 if clean.exists() or burned.exists():raise FileExistsError('Choose a new revision name before replacing a rendered output.')
 # AAC smears nonzero samples into END-03 at its block boundaries. Preserve
 # the original FLAC packets for full masters. FLAC-in-MP4 is supported by
 # Chromium; ALAC has substantially less direct browser support.
 audio_codec=['-c:a','copy','-strict','-2'] if full else ['-c:a','aac','-b:a','256k']
 run(['ffmpeg','-nostdin','-v','error','-f','concat','-safe','0','-i',str(concat),'-i',str(audio),'-map','0:v','-map','1:a','-t',str(duration),'-c:v','copy',*audio_codec,'-movflags','+faststart',str(clean)])
 if full:
  silence=measure_silence(clean)
  (ROOT/'qa/clean_master_END03_samples.json').write_text(json.dumps(silence,indent=2))
  if not silence['all_zero']:raise RuntimeError('Rendered master failed absolute-silence sample test.')
 run(['ffmpeg','-nostdin','-v','error','-i',str(clean),'-vf','ass=subtitles/SILENT_PROTOCOL_BILINGUAL.ass:fontsdir=graphics/fonts','-c:v','libx264','-crf','18','-preset','fast','-threads','4','-c:a','copy',*(['-strict','-2'] if full else []),'-movflags','+faststart',str(burned)])
 rows=[]
 for p in [clean,burned]:
  run(['ffmpeg','-nostdin','-v','error','-xerror','-i',str(p),'-f','null','-'])
  probe=json.loads(run(['ffprobe','-v','error','-show_streams','-show_format','-of','json',str(p)]))
  assert abs(float(probe['format']['duration'])-duration)<.1
  row={'path':str(p.relative_to(ROOT)),'bytes':p.stat().st_size,'duration':probe['format']['duration'],'decode':'PASS','probe':probe}
  if full:
   row['END03_sample_test']=measure_silence(p)
   if not row['END03_sample_test']['all_zero']:raise RuntimeError('Absolute silence failed: '+str(p))
  rows.append(row)
 report={'status':'FULL_FILM_RENDERED_CREATIVE_QA_PENDING' if full else 'WORKPRINT_NOT_FINAL','outputs':rows,'sections':sections,'duration':duration}
 (ROOT/'qa'/('master_encoding.json' if full else 'workprint_encoding.json')).write_text(json.dumps(report,ensure_ascii=False,indent=2));print(json.dumps(report,ensure_ascii=False),flush=True)
if __name__=='__main__':main('--full' in sys.argv)
