import pathlib,subprocess,json,hashlib,os,numpy as np
import resume_control as c
ROOT=c.ROOT;source=ROOT/'output/SILENT_PROTOCOL_MIX_DERIVED_v2_18M15S.flac';target=ROOT/'output/SILENT_PROTOCOL_MIX_SCENE_REVIEW_B09_v1_18M15S.flac'
if target.exists():raise FileExistsError(target)
tl=json.loads((ROOT/'project/full_picture_timeline.json').read_text());s=next(x for x in tl if x['id']=='E5-06');a,b=s['start_frame']*2000,s['end_frame']*2000
filter=f'[0:a]asplit=3[pre][mid][post];[pre]atrim=end_sample={a},asetpts=PTS-STARTPTS[A];[mid]atrim=start_sample={a}:end_sample={b},volume=0,asetpts=PTS-STARTPTS[B];[post]atrim=start_sample={b},asetpts=PTS-STARTPTS[C];[A][B][C]concat=n=3:v=0:a=1[out]'
command=['ffmpeg','-nostdin','-v','error','-i',str(source),'-filter_complex',filter,'-map','[out]','-c:a','flac','-sample_fmt','s32','-bits_per_raw_sample','24',str(target)]
subprocess.run(command,check=True)
with target.open('rb') as f:os.fsync(f.fileno())
def measure(path,start,end):
 p=subprocess.Popen(['ffmpeg','-nostdin','-v','error','-xerror','-i',str(path),'-af',f'atrim=start_sample={start}:end_sample={end}', '-f','s32le','pipe:1'],stdout=subprocess.PIPE)
 h=hashlib.sha256();count=0;nonzero=0
 while block:=p.stdout.read(4*1024*1024):h.update(block);count+=len(block);nonzero+=int(np.count_nonzero(np.frombuffer(block,dtype='<i4')))
 if p.wait():raise RuntimeError('PCM decode failed')
 return {'frames':count//8,'nonzero_samples':nonzero,'pcm_sha256':h.hexdigest()}
decode=subprocess.run(['ffmpeg','-nostdin','-v','error','-xerror','-i',str(target),'-f','null','-'],capture_output=True,text=True)
before=[measure(source,0,a),measure(target,0,a)];after=[measure(source,b,1095*48000),measure(target,b,1095*48000)];mute=measure(target,a,b);ending=measure(target,round(977.5*48000),round(983.5*48000))
assert decode.returncode==0 and before[0]==before[1] and after[0]==after[1] and mute['frames']==b-a and mute['nonzero_samples']==0 and ending['frames']==288000 and ending['nonzero_samples']==0
probe=json.loads(subprocess.check_output(['ffprobe','-v','error','-show_format','-show_streams','-of','json',str(target)]));assert abs(float(probe['format']['duration'])-1095)<.001
report={'status':'WORK_MIX_NOT_FINAL','output':str(target.relative_to(ROOT)),'bytes':target.stat().st_size,'sha256':c.sha(target),'source_sha256':c.sha(source),'command':command,'full_decode_exit':decode.returncode,'probe':probe,'E5_06_sample_interval':[a,b],'E5_06':mute,'END_03':ending,'outside_silence_bit_exact':before[0]==before[1] and after[0]==after[1],'creative_dialogue_qa':'PENDING'}
c.atomic(ROOT/'qa/B09_scene_silence_audio.json',report);c.atomic(ROOT/'project/audio_working_selection.json',{'path':str(target.relative_to(ROOT)),'qa':'qa/B09_scene_silence_audio.json','status':'WORK_NOT_FINAL'});print(json.dumps(report),flush=True)
