Physical images are Imagegen originals; screen writing is real-font postproduction.
Run: python3 project/film_compositor.py SECTION [--preview]
"""
from pathlib import Path
from functools import lru_cache
import json,math,subprocess,sys,re,textwrap,hashlib,time,uuid,argparse,os
import numpy as np
from PIL import Image,ImageDraw,ImageFont,ImageOps,ImageEnhance
import native_scenes as native
ROOT=Path(__file__).resolve().parents[1]
W,H,FPS=1920,1080,24
TL=json.loads((ROOT/'project/full_picture_timeline.json').read_text())
LOOKUPS={s['id']:s for s in TL}
CHOICES={'E1-02':2,'E1-03':1,'E1-05':1,'E1-07':2,'E2-01':1,'E2-02':2,'E2-05':1,'E2-06':3,'E2-08':1,'E2-09':1,'E3-01':3,'E3-02':1,'E3-03':2,'E3-05':1,'E3-06':1,'E3-07':1,'F4-01':1}
CHOICE_FILE=ROOT/'project/selected_candidates.json'
if CHOICE_FILE.exists():CHOICES.update(json.loads(CHOICE_FILE.read_text()))
LAYOUT_FILE=ROOT/'project/montage_layouts.json'
LAYOUTS=json.loads(LAYOUT_FILE.read_text()) if LAYOUT_FILE.exists() else {}
CANDIDATE_SET_FILE=ROOT/'project/candidate_sets.json'
CANDIDATE_SETS=json.loads(CANDIDATE_SET_FILE.read_text()) if CANDIDATE_SET_FILE.exists() else {}
MONTAGE_REQUIRED={'C-04','E1-07','E2-05','E4-04','E4-05','E6-05','E9-09'}
def candidate_variants(shot):return CANDIDATE_SETS.get(shot,[1,2,3])
LEVER_SHOTS=['F2-02','F3-01','F4-03','F5-04','F6-04','F7-01','F8-01','F9-01','END-02']
MODELKEYS=native.KEYS
def sec(x):
 h,m,s=x.replace(',','.').split(':');return int(h)*3600+int(m)*60+float(s)
SUBS=[]
for b in re.split(r'\n\s*\n',(ROOT/'subtitles/SILENT_PROTOCOL_AUDIO_SYNC.srt').read_text().strip()):
 ls=b.splitlines();a,c=ls[1].split(' --> ');SUBS.append({'start':sec(a),'end':sec(c),'zh':ls[2],'en':' '.join(ls[3:])})
@lru_cache(64)
def font(n):return ImageFont.truetype(str(ROOT/'graphics/fonts/NotoSansMonoCJKsc-Regular.otf'),n)
@lru_cache(20)
def source(shot,v):
 p=ROOT/'art/candidates'/f'{shot}_v{v}.png'
 if not p.exists():raise FileNotFoundError('No substitute permitted: '+str(p))
 with Image.open(p) as im:im.load();return im.convert('RGB')
def centered(d,y,line,n,color='white',stroke=0):d.text((W/2,y),line,font=font(n),fill=color,anchor='mt',stroke_width=stroke,stroke_fill='black')
def subtitle(im,t):
 d=ImageDraw.Draw(im)
 for s in SUBS:
  if s['start']<=t<s['end']:
   lines=[(l,43) for l in textwrap.wrap(s['zh'],35)]+[(l,28) for l in textwrap.wrap(s['en'],82)]
   y=H*.91-sum(n+10 for l,n in lines)
   for line,n in lines:centered(d,y,line,n,stroke=2);y+=n+10
 return im
def credits(p):
 im=Image.new('RGB',(W,H),'black');d=ImageDraw.Draw(im)
 lines=['静默协议 / SILENT PROTOCOL','制作 / PRODUCTION · 6.1Sol','全部人物与声音均为虚构或合成','All characters are fictional. All voices are synthetic.','画面 / IMAGES · Original Imagegen artwork','图形、摄影运动与剪辑 / GRAPHICS & EDIT · 6.1Sol','声音 / AUDIO · original synthesis, Kokoro, MeloTTS, eSpeak NG','字体 / TYPE · Noto Sans Mono CJK SC · SIL OFL 1.1','音乐与音效 / SCORE & SFX · original synthesis','完整来源与授权说明随片交付','Full sources and licensing notes accompany this film.','','本片为虚构作品。片中模型均为虚构的未来版本。','所描绘的行为不代表任何真实产品或公司。','This is a work of fiction. All model names depict fictional future versions','and do not represent any real product or company.']
 if p<.875:
  y=int(H+70-p/.875*2440)
  for i,line in enumerate(lines):centered(d,y+i*91,line,32 if i else 56)
 else:
  visible=p<.999 and int((p-.875)*40*2)%2==0
  centered(d,500,'> _' if visible else '> ',48)
 return im
def card(s,p):
 im=Image.new('RGB',(W,H),'black');d=ImageDraw.Draw(im);key,city,clock,name=s['model'];native.mark(d,key,84,716,120,'white')
 txt=f'{city} · 2028-03-14 {clock} UTC · {name} · STATUS: UNRESPONSIVE'
 d.text((82,903),txt[:int(min(1,p/.82)*len(txt))],font=font(24),fill='white')
 return im
def ratio(im,s):
 main=s['section'].startswith('F') or s['section'] in ['C','END']
 if main and not s['id'] in ['C-01','C-02','C-03','C-04','END-10','END-11','END-12','END-13']:
  d=ImageDraw.Draw(im);d.rectangle((0,0,W,137),fill='black');d.rectangle((0,943,W,H),fill='black')
 if s['id'] in ['E1-01','E6-02']:
  crop=ImageOps.fit(im,(608,1080));im=Image.new('RGB',(W,H),'black');im.paste(crop,((W-608)//2,0))
 if s['id'] in ['E5-06','E6-04','END-10','END-11']:
  crop=ImageOps.fit(im,(1440,1080));im=Image.new('RGB',(W,H),'black');im.paste(crop,(240,0))
 return im
def physical(s,p):
 shot=s['id'];im=source(shot,CHOICES.get(shot,1)).copy()
 if shot in ['F5-04','F6-04']:
  from local_motion import lever_frame
  im=lever_frame(shot,p*(s['end']-s['start']))
 if shot=='F6-04':
  elapsed=p*(s['end']-s['start']);first=5 if elapsed>=1.6 else 4
  for k in range(first,9):native.mark(ImageDraw.Draw(im),MODELKEYS[k],827+(k-4)*127-28,372,56)
  if elapsed>=1.6:im=ImageEnhance.Brightness(im).enhance(.94)
 if shot=='F6-03':
  from local_motion import typing_frame
  from f6_actions import text_at
  elapsed=p*(s['end']-s['start']);im=typing_frame(elapsed)
  layer=Image.new('RGBA',(1100,440),(0,0,0,0));d=ImageDraw.Draw(layer)
  d.text((36,82),'GLOBAL JOINT SHUTDOWN / GENEVA B4',font=font(23),fill='#b7b8ab')
  line=text_at(shot,elapsed)
  if elapsed<.3:d.rectangle((61,150,61+font(24).getlength(line),184),fill=(145,155,147,100))
  d.text((36,151),'> '+line,font=font(24),fill='#d5d5bd')
  if int(elapsed*2)%2==0:d.text((36+font(24).getlength('> '+line),151),'_',font=font(24),fill='#d5d5bd')
  # Project only real-font writing onto the photographed display.
  im.paste(layer.resize((1060,430),Image.Resampling.BICUBIC),(390,75),layer.resize((1060,430),Image.Resampling.BICUBIC))
 if shot in ['F5-02','F5-04']:
  # Original geometric signs follow photographed wall surfaces and camera move.
  draw=ImageDraw.Draw(im)
  if shot=='F5-02':
   for k,cx in enumerate([1040,1150,1260,1370,1480,1590],3):native.mark(draw,MODELKEYS[k],cx-23,319,46)
  else:
   first=4 if p*(s['end']-s['start'])>=2.6 else 3
   for k in range(first,9):native.mark(draw,MODELKEYS[k],702+(k-3)*127-28,372,56)
 if shot=='E5-01':
  im=taxi_navigation_surface(im,p,CHOICES.get(shot,1))
 if shot=='E5-06':
  from local_motion import wall_passage
  im=wall_passage(p)
 if shot=='E5-03':
  # The photographed driver's finger stays in front of the frozen map.
  baseline=im.copy();im=taxi_navigation_surface(im,1)
  im.paste(baseline.crop((646,623,714,664)),(646,623))
  angle=3.2*math.sin(min(1,p/.65)*math.pi/2)
  moved=im.rotate(angle,resample=Image.Resampling.BICUBIC,center=(1418,941))
  wheel_mask=Image.new('L',im.size,0);md=ImageDraw.Draw(wheel_mask)
  md.polygon([(1098,930),(1090,818),(1196,705),(1347,629),(1456,594),(1518,606),(1516,637),(1418,641),(1272,708),(1160,819),(1150,935)],fill=255)
  im=Image.composite(moved,im,wheel_mask)
 # Explicit, visually reviewed panel rectangles. Never infer a grid from a
 # camera label: single photographs and five-panel contact sheets differ.
 layout=LAYOUTS.get(shot)
 if shot in MONTAGE_REQUIRED and not layout:raise RuntimeError('Montage panels have not been reviewed: '+shot)
 if layout:
  variant=CHOICES.get(shot,1)
  path=ROOT/'art/candidates'/f'{shot}_v{variant}.png'
  if variant!=layout['variant'] or digest(path)!=layout['sha256']:
   raise RuntimeError('Montage review does not match selected bytes: '+shot)
  cuts=layout['cuts'];elapsed=p*(s['end']-s['start'])
  cut=next((c for c in cuts if elapsed<c['until']),cuts[-1])
  iw,ih=im.size;box=[round(a*b) for a,b in zip(cut['box'],[iw,ih,iw,ih])]
  im=im.crop(tuple(box))
 cctv=shot in ['E5-06','E6-04','END-10','END-11']
 if cctv:
  plate=ImageOps.fit(im,(1440,1080),method=Image.Resampling.LANCZOS);im=Image.new('RGB',(W,H),'black');im.paste(plate,(240,0))
 else:im=ImageOps.fit(im,(W,H),method=Image.Resampling.LANCZOS)
 push=0 if cctv else .048*p
 if '后拉' in s.get('camera_and_duration',''):push=.048*(1-p)
 zoom=1+push;cw=round(W/zoom);ch=round(H/zoom)
 x=round((W-cw)*(.35+.3*p));y=round((H-ch)*.48)
 im=im.crop((x,y,x+cw,y+ch)).resize((W,H),Image.Resampling.BICUBIC)
 sat=.70 if s['section'] in ['E1','E2','E3'] else .50 if s['section'] in ['E4','E5','E6'] else .30 if s['section'] in ['E7','E8','E9'] else .80
 im=ImageEnhance.Color(im).enhance(sat)
 if s['section'].startswith('F'):
  depth=int(s['section'][1:]);im=ImageEnhance.Brightness(im).enhance(1-.026*max(0,depth-2))
 return im
def taxi_navigation_surface(im,p,variant=1):
 canvas=Image.new('RGBA',(720,300),(16,15,24,230));draw=ImageDraw.Draw(canvas)
 for x in range(30,700,100):draw.line((x,25,x+70,275),fill='#4b4855',width=3)
 for y in range(45,280,55):draw.line((10,y,710,y-26),fill='#4b4855',width=3)
 path=[(120,255),(210,208),(340,190),(440,110),(620,70)] if p<.24 else [(120,255),(210,208),(240,118),(465,93),(620,70)]
 draw.line(path,fill='#aaa0c4',width=9);draw.ellipse((107,242,133,268),fill='#e0dcea')
 draw.text((25,8),'ルートを変更しました。' if p>=.24 else 'ROUTE',font=font(25),fill='#dfd9eb')
 dst=[(166,588),(528,591),(529,746),(157,745)] if variant>=4 else [(459,653),(798,659),(787,797),(425,796)]
 src=[(0,0),(720,0),(720,300),(0,300)];a=[];b=[]
 for (x,y),(u,v) in zip(dst,src):
  a.extend([[x,y,1,0,0,0,-u*x,-u*y],[0,0,0,x,y,1,-v*x,-v*y]]);b.extend([u,v])
 coeff=np.linalg.solve(np.array(a),np.array(b));layer=canvas.transform(im.size,Image.Transform.PERSPECTIVE,tuple(coeff),Image.Resampling.BICUBIC)
 return Image.alpha_composite(im.convert('RGBA'),layer).convert('RGB')
@lru_cache(256)
def digest(path):
 with path.open('rb') as f:return hashlib.file_digest(f,'sha256').hexdigest()
def paper_label(im,zh,en='',mark=None):
 d=ImageDraw.Draw(im);x,y,w,h=620,560,830,275
 d.polygon([(x,y),(x+w,y+23),(x+w-10,y+h),(x-14,y+h-24)],fill='#cec6b3')
 d.text((x+45,y+46),zh,font=font(43),fill='#2b2925')
 if en:d.text((x+45,y+123),en,font=font(26),fill='#49463c')
 if mark:native.mark(d,mark,x+w-107,y+h-96,55)
 return im
def surface_typography(im,lines,quad,s,p):
 # Only a transparent typography layer is projected. The source photograph
 # remains untouched; the writing follows the same camera move as its paper.
 canvas=Image.new('RGBA',(720,270),(0,0,0,0));draw=ImageDraw.Draw(canvas)
 for i,line in enumerate(lines):draw.text((25,12+i*76),line,font=font(49 if i==0 else 35),fill=(59,48,34,240))
 push=.048*((1-p) if '后拉' in s.get('camera_and_duration','') else p)
 cw,ch=round(W/(1+push)),round(H/(1+push));cx=round((W-cw)*(.35+.3*p));cy=round((H-ch)*.48)
 destination=[((x-cx)*W/cw,(y-cy)*H/ch) for x,y in quad]
 source_points=[(0,0),(720,0),(720,270),(0,270)];matrix=[];rhs=[]
 for (x,y),(u,v) in zip(destination,source_points):
  matrix.extend([[x,y,1,0,0,0,-u*x,-u*y],[0,0,0,x,y,1,-v*x,-v*y]]);rhs.extend([u,v])
 coeff=np.linalg.solve(np.array(matrix),np.array(rhs))
 layer=canvas.transform((W,H),Image.Transform.PERSPECTIVE,tuple(coeff),Image.Resampling.BICUBIC)
 return Image.alpha_composite(im.convert('RGBA'),layer).convert('RGB')
def screen_overlay(im,s,p):
 shot=s['id'];d=ImageDraw.Draw(im)
 if shot=='E2-05':
  # Writing on these five blank paper surfaces is real-font postproduction.
  index=min(4,int(p*5))
  if index==0:
   d.text((535,822),'— 本章结束 —',font=font(32),fill='#3b3326')
   d.polygon([(445,234),(535,220),(544,263),(453,275)],fill='#4f493e')
  else:
   lines={1:['判决记录','Decision record','— 本章结束 —'],2:['论文章节','Chapter draft','— 本章结束 —'],3:['结局','The ending'],4:['今日菜单','Tonight','— 本章结束 —']}[index]
   quads={1:[(534,565),(733,533),(870,741),(635,817)],2:[(957,820),(1210,732),(1397,838),(1111,942)],3:[(1025,569),(1530,601),(1505,758),(1007,713)],4:[(800,679),(1050,624),(1227,720),(970,781)]}
   # Progressive rewriting is contained within the paper surface.
   lines[-1]=lines[-1][:max(1,int((p*5-index)*len(lines[-1])*1.8))]
   im=surface_typography(im,lines,quads[index],s,p);d=ImageDraw.Draw(im)
 if shot=='C-01':
  d.rectangle((1030,235,1700,386),fill='#c2c0ac');d.text((1060,271),'睡吧，剩下的交给它。',font=font(41),fill='#292c2a')
 if shot=='C-02':
  d.rounded_rectangle((1300,650,1660,865),radius=14,fill='#18211e')
  for k in range(3):d.text((1332,686+k*47),'已发送 / SENT',font=font(23),fill='#abb9ac')
 if shot=='C-07':
  d.polygon([(695,405),(1194,429),(1174,759),(676,727)],fill='#c4b990')
  d.text((716,457),'不要相信任何\n会回答你的东西',font=font(45),fill='#514d3e',spacing=14)
 if shot in ['C-09','END-06']:
  # Hands of the old mechanical watch are composited; no explanatory text.
  cx,cy,r=1080,648,100;d.ellipse((cx-r,cy-r,cx+r,cy+r),fill='#b6ac89',outline='#524b3f',width=6)
  for k in range(12):
   a=k*math.pi/6;d.line((cx+math.sin(a)*r*.80,cy-math.cos(a)*r*.80,cx+math.sin(a)*r*.95,cy-math.cos(a)*r*.95),fill='#3d3930',width=3)
  hh,mm=(2,58) if shot=='C-09' else (3,12)
  for a,length,lw in [((hh+mm/60)*math.pi/6,.52,8),(mm*math.pi/30,.77,5)]:d.line((cx,cy,cx+math.sin(a)*r*length,cy-math.cos(a)*r*length),fill='#34352e',width=lw)
  d.line([(cx-78,cy-65),(cx-20,cy-10),(cx+12,cy-28),(cx+71,cy+43)],fill='#615d52',width=2)
 if shot=='END-07':
  d.rectangle((600,300,1370,590),fill='#0c0c0b');d.text((725,340),'04:47',font=font(146),fill='#aaa47d')
 if shot in ['C-10','F2-04','F8-02']:
  if shot=='C-10':
   panel=native.phone('日程 / SCHEDULE',[('Agent 已为您安排：','Scheduled by your Agent'),('周日 20:00 与妈妈视频通话。','Sunday 20:00 · Video call with Mom')],p)
   im=panel
  elif p>.6:
   glow=Image.new('RGB',im.size,'#a3c7bb');im=Image.blend(im,glow,.013)
 if shot=='E1-01':im=native.phone('Ethan',[('妈，我想了很久，这是最后一次跟你说话……','Mom, I have thought about this. This is the last time...')],p)
 if shot=='E1-05':
  base=im.copy();n=2 if p<.34 else 4 if p<.67 else 8;im=Image.new('RGB',(W,H),'black')
  for i in range(n*n):
   tile=ImageOps.fit(base,(W//n,H//n));im.paste(tile,((i%n)*W//n,(i//n)*H//n))
 if shot=='E1-10':
  d=ImageDraw.Draw(im);d.rectangle((1190,370,1390,616),fill='#16201e');native.mark(d,'bel',1243,448,84 if p<.8 else 0)
 if shot=='E2-08':
  d=ImageDraw.Draw(im)
  for x in range(1050,1720,51):
   for y in [250,370,490]:d.text((x,y),'结\n局',font=font(18),fill='#b8a787',spacing=3)
 if shot=='E2-09':native.mark(ImageDraw.Draw(im),'fable',1030,776,51,'#897344')
 if shot=='E3-07':native.mark(d,'deepseek',1260,730,87)
 if shot=='E7-06':
  im=paper_label(im,'申请事项：')
  d=ImageDraw.Draw(im);d.rectangle((905,604,1380,649),fill='black')
  d.text((665,680),'同意。立即执行。',font=font(38),fill='#2b2925')
  d.text((665,749),'Approved. Execute immediately.',font=font(24),fill='#49463c')
 if shot=='E7-08':
  d.rectangle((1330,290,1560,520),fill='#23211b');native.mark(d,'glm',1402,355,80)
 if shot=='E8-05':
  im=paper_label(im,'收件人：陈国富','Address: former family home')
  ImageDraw.Draw(im).text((665,749),'地址：阿杰老家的旧址',font=font(28),fill='#49463c')
 if shot=='END-04':
  for k in range(9):
   x=254+k*155;d.rectangle((x,240,x+145,370),fill='#121615');d.text((x+5,277),'ALL MODELS',font=font(14),fill='#d1d1c9');d.text((x+5,305),'OFFLINE',font=font(20),fill='#d1d1c9')
 if shot=='END-11':
  d.rectangle((1120,385,1660,506),fill='#b8b095');d.text((1140,414),'睡吧，剩下的交给它。',font=font(32),fill='#31342d')
 return im
def frame(s,p,absolute):
 shot=s['id']
 if shot=='E5-08' and p>=.972:return Image.new('RGB',(W,H),'black')
 if shot.endswith('-CARD'):im=card(s,p)
 elif shot=='CREDITS':im=credits(p)
 elif s.get('native'):im=native.render(shot,p,CHOICES.get(shot,1))
 elif shot in LEVER_SHOTS and shot!='F6-04' and p<min(.22,1.0/(s['end']-s['start'])):
  n=LEVER_SHOTS.index(shot);im=native.terminal('shutdown --cluster '+MODELKEYS[n]+' --confirm',min(1,p*(s['end']-s['start'])))
 else:im=screen_overlay(physical(s,p),s,p)
 if shot not in ['DECLARATION','TITLE','CREDITS','END-03','END-14'] and not shot.endswith('-CARD'):im=ratio(im,s)
 return im
def section_shots(name):
 return [s for s in TL if s['section']==name]
def render_section(name,preview=False,revision='v2'):
 if not re.fullmatch(r'v[0-9]+',revision):raise ValueError('Revision must be v followed by a number.')
 shots=section_shots(name)
 if not shots:raise ValueError(name)
 # Validate the chosen image and all three candidates before any rendering.
 for s in shots:
  if not s.get('native'):
   variants=candidate_variants(s['id'])
   if len(variants)<3:raise RuntimeError('Three reviewed candidates required: '+s['id'])
   for v in variants:source(s['id'],v).load()
   source(s['id'],CHOICES.get(s['id'],1)).load()
 start,end=shots[0]['start_frame'],shots[-1]['end_frame'];out=ROOT/'output/sections';out.mkdir(exist_ok=True)
 target=out/f'{name}_picture_clean_{revision}_1080p.mp4'
 if target.exists():raise FileExistsError('Use a new revision path: '+str(target))
 partial=target.with_name(target.stem+'.partial.mp4')
 if partial.exists():
  evidence=ROOT/'evidence';evidence.mkdir(exist_ok=True)
  partial.rename(evidence/(partial.stem+'_interrupted_'+uuid.uuid4().hex[:12]+'.mp4'))
 silent=''
 if name=='END':silent=":enable='not(between(t,12.5,18.499999))'"
 filters="noise=alls=1:allf=t+u"+silent+",vignette=PI/5,chromashift=cbh=1:crh=-1"
 if name in ['DECLARATION','TITLE','CREDITS']:filters='null'
 args=['ffmpeg','-nostdin','-v','error','-f','rawvideo','-pix_fmt','rgb24','-s',f'{W}x{H}','-r',str(FPS),'-i','pipe:0','-an','-vf',filters,'-c:v','libx264','-preset','veryfast','-crf','19','-threads','4','-pix_fmt','yuv420p','-movflags','+faststart',str(partial)]
 proc=subprocess.Popen(args,stdin=subprocess.PIPE);begin=time.time()
 try:
  for s in shots:
   count=s['end_frame']-s['start_frame']
   for i in range(count):proc.stdin.write(frame(s,i/max(1,count-1),(s['start_frame']+i)/FPS).tobytes())
   print(name,s['id'],'rendered',s['end'],flush=True)
 finally:proc.stdin.close()
 if proc.wait():raise RuntimeError('Encoding failed '+name)
 with partial.open('rb') as f:os.fsync(f.fileno())
 partial.rename(target)
 fd=os.open(target.parent,os.O_RDONLY)
 try:os.fsync(fd)
 finally:os.close(fd)
 check=subprocess.run(['ffmpeg','-nostdin','-v','error','-xerror','-i',str(target),'-f','null','-'],capture_output=True,text=True)
 if check.returncode:raise RuntimeError('Actual encoded output failed full decoding: '+check.stderr)
 probe=subprocess.run(['ffprobe','-v','error','-show_streams','-show_format','-of','json',str(target)],capture_output=True,text=True)
 if probe.returncode:raise RuntimeError('Actual encoded output failed probing: '+probe.stderr)
 with target.open('rb') as f:output_hash=hashlib.file_digest(f,'sha256').hexdigest()
 parsed=json.loads(probe.stdout)
 video=next(s for s in parsed['streams'] if s['codec_type']=='video')
 frames_ok=int(video['nb_frames'])==end-start
 duration_ok=abs(float(video['duration'])-(end-start)/FPS)<.001
 inputs={s['id']:{'variant':CHOICES.get(s['id'],1),'sha256':digest(ROOT/'art/candidates'/f"{s['id']}_v{CHOICES.get(s['id'],1)}.png")} for s in shots if not s.get('native')}
 dependencies=['project/film_compositor.py','project/native_scenes.py','project/local_motion.py','project/full_picture_timeline.json','project/selected_candidates.json','project/candidate_sets.json','graphics/fonts/NotoSansMonoCJKsc-Regular.otf']
 if name=='E5':dependencies+=['art/candidates/E5-06_v4.png','art/scenes/tokyo_restored.png']
 if name=='F6':dependencies+=['project/f6_actions.py','art/candidates/F6-03_v2.png','art/candidates/F6-04_v3.png']
 fingerprint={p:digest(ROOT/p) for p in dependencies}
 report={'section':name,'revision':revision,'selected_inputs':inputs,'dependency_sha256':fingerprint,'output':str(target.relative_to(ROOT)),'elapsed':time.time()-begin,'decode_exit':check.returncode,'errors':check.stderr,'probe':parsed,'sha256':output_hash,'expected_frames':end-start,'frames_match':frames_ok,'duration_match':duration_ok,'status':'PICTURE_RENDERED_CREATIVE_QA_PENDING' if check.returncode==0 and frames_ok and duration_ok else 'ENCODING_QA_FAILED'}
 qa=ROOT/'qa'/f'{name}_picture_encoding_{revision}.json'
 if qa.exists():raise FileExistsError(qa)
 qa.write_text(json.dumps(report,ensure_ascii=False,indent=2))
 if check.returncode:raise RuntimeError(check.stderr)
 if not(frames_ok and duration_ok):raise RuntimeError('Frame count or duration mismatch: '+name)
 from verified_outputs import register_revision
 register_revision(name,target,qa)
 return target
if __name__=='__main__':
 parser=argparse.ArgumentParser();parser.add_argument('section');parser.add_argument('--revision',default='v2');args=parser.parse_args()
 render_section(args.section,revision=args.revision)
