from pathlib import Path
import json,sys,subprocess,hashlib,re,os
from verified_outputs import verified_section,section_record
ROOT=Path(__file__).resolve().parents[1]
def run(args):
    p=subprocess.run(args,cwd=ROOT,capture_output=True,text=True)
    if p.returncode:raise RuntimeError(p.stderr)
def clock(t):
    cs=round(t*100);h,cs=divmod(cs,360000);m,cs=divmod(cs,6000);s,cs=divmod(cs,100)
    return f'{h}:{m:02d}:{s:02d}.{cs:02d}'
def seconds(text):
    h,m,s=text.replace(',','.').split(':');return 3600*int(h)+60*int(m)+float(s)
def main(section,revision):
    if not verified_section(section):raise RuntimeError('No verified picture revision')
    timeline=json.loads((ROOT/'project/full_picture_timeline.json').read_text());shots=[s for s in timeline if s['section']==section]
    start,end=shots[0]['start'],shots[-1]['end'];length=end-start;picture,qa=section_record(section)
    seed=(ROOT/'subtitles/SILENT_PROTOCOL_BILINGUAL.ass').read_text();header=seed.split('[Events]')[0]+'[Events]\nFormat: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, Text\n'
    lines=[]
    for block in re.split(r'\n\s*\n',(ROOT/'subtitles/SILENT_PROTOCOL_AUDIO_SYNC.srt').read_text().strip()):
        text=block.splitlines();a,b=text[1].split(' --> ');a,b=seconds(a),seconds(b)
        if b<=start or a>=end:continue
        a,b=max(a,start)-start,min(b,end)-start
        lines.extend([f'Dialogue: 0,{clock(a)},{clock(b)},ZH,,0,0,0,,{text[2]}',f'Dialogue: 0,{clock(a)},{clock(b)},EN,,0,0,0,,'+r'\N'.join(text[3:])])
    ass=ROOT/f'subtitles/{section}_SEQUENCE_REVIEW_{revision}.ass'
    if ass.exists():raise FileExistsError(ass)
    ass.write_text(header+'\n'.join(lines)+'\n')
    audio=ROOT/'output/SILENT_PROTOCOL_MIX_DERIVED_v2_18M15S.flac'
    selection=ROOT/'project/audio_working_selection.json'
    if selection.exists():audio=ROOT/json.loads(selection.read_text())['path']
    clean=ROOT/f'output/{section}_SEQUENCE_REVIEW_{revision}_1080P_CLEAN.mp4';burned=ROOT/f'output/{section}_SEQUENCE_REVIEW_{revision}_1080P_BILINGUAL.mp4'
    if clean.exists() or burned.exists():raise FileExistsError('Choose new version')
    commands=[['ffmpeg','-nostdin','-v','error','-i',str(picture),'-ss',str(start),'-i',str(audio),'-t',str(length),'-map','0:v:0','-map','1:a:0','-c:v','copy','-c:a','flac','-strict','-2','-movflags','+faststart',str(clean)],['ffmpeg','-nostdin','-v','error','-i',str(clean),'-vf',f"ass={ass.relative_to(ROOT)}:fontsdir=graphics/fonts",'-c:v','libx264','-preset','veryfast','-crf','18','-threads','3','-pix_fmt','yuv420p','-c:a','copy','-strict','-2','-movflags','+faststart',str(burned)]]
    for command in commands:
        run(command)
        with Path(command[-1]).open('rb') as f:os.fsync(f.fileno())
    outputs=[]
    for path in [clean,burned]:
        check=subprocess.run(['ffmpeg','-nostdin','-v','error','-xerror','-i',str(path),'-f','null','-'],capture_output=True,text=True)
        probe=json.loads(subprocess.check_output(['ffprobe','-v','error','-show_streams','-show_format','-of','json',str(path)]));video=next(s for s in probe['streams'] if s['codec_type']=='video')
        assert check.returncode==0 and int(video['nb_frames'])==round(length*24) and abs(float(video['duration'])-length)<.001
        outputs.append({'path':str(path.relative_to(ROOT)),'sha256':hashlib.sha256(path.read_bytes()).hexdigest(),'bytes':path.stat().st_size,'decode_exit':check.returncode,'probe':probe})
    report={'status':'WORK_REVIEW_NOT_FINAL','section':section,'picture_qa':str(qa.relative_to(ROOT)),'source_audio':str(audio.relative_to(ROOT)),'audio_content_and_subtitle_sync':'CREATIVE_QA_PENDING','actual_commands':commands,'outputs':outputs}
    (ROOT/f'qa/{section}_sequence_review_{revision}.json').write_text(json.dumps(report,ensure_ascii=False,indent=2));print('REVIEW_ENCODED',section,length)
if __name__=='__main__':main(sys.argv[1],sys.argv[2])
␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀project/build_timeline.py␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀0000644␀0000000␀0000000␀00000006423␀00000000000␀012757␀ 0␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀ustar␀00␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀"""Reconstruct the edit against the preserved 1095-second soundtrack."""
from pathlib import Path
import json,re
ROOT=Path(__file__).resolve().parents[1]
FPS=24
SECTIONS=[('C',4,120),('F1',132,160),('E1',160,230),('F2',230,250),('E2',250,320),('F3',320,340),('E3',340,405),('F4',405,425),('E4',425,495),('F5',495,520),('E5',520,590),('F6',590,615),('E6',615,680),('F7',680,705),('E7',705,770),('F8',770,800),('E8',800,870),('F9',870,900),('E9',900,965),('END',965,1055)]
MODELS=[('bel','SAN FRANCISCO','03:00','GPT-7.4 Bel'),('fable','LONDON','03:02','Claude Fable 6.5'),('deepseek','SHENZHEN','03:03','DeepSeek V6-Pro'),('kimi','SHANGHAI','03:04','Kimi K5'),('argon','TOKYO','03:05','Gemini 6.1 Argon'),('grok','TEXAS / GLOBAL FEED','03:07','Grok-6.7'),('glm','BEIJING','03:08','GLM-7.2'),('qwen','HANGZHOU','03:10','Qwen5.8 Max'),('minimax','SEOUL','03:12','Minimax M5.2')]
def frames(t):return round(t*FPS)
shots=json.loads((ROOT/'project/full_scene_descriptions.json').read_text())
native=set(json.loads((ROOT/'project/native_shot_ids.json').read_text()))
timeline=[{'id':'DECLARATION','start_frame':0,'end_frame':96,'native':True,'section':'DECLARATION'}]
for section,a,b in SECTIONS:
 block=[s for s in shots if s['id'].rsplit('-',1)[0]==section]
 if re.fullmatch(r'E[1-9]',section):
  timeline.append({'id':section+'-CARD','start_frame':frames(a),'end_frame':frames(a+4),'native':True,'section':section,'model':MODELS[int(section[1:])-1]});a+=4
 weights=[float(re.search(r'(\d+(?:\.\d+)?)s',s['camera_and_duration']).group(1)) for s in block]
 anchors={0:frames(a),len(block):frames(b)}
 if section=='E2':anchors.update({5:frames(283+4/24),6:frames(289+7/24),7:frames(309+7/24)})
 if section=='E4':anchors.update({2:frames(440+13/24),3:frames(447+8/24),4:frames(456+10/24),5:frames(464+22/24),6:frames(474+15/24)})
 if section=='F7':anchors.update({1:frames(687),2:frames(695)})
 if section=='F9':anchors.update({1:frames(875),2:frames(890.5),3:frames(896)})
 if section=='E9':anchors.update({3:frames(921+5/24),5:frames(934+20/24),6:frames(948+2/24)})
 if section=='END':anchors.update({2:frames(977.5),3:frames(983.5),13:frames(1051+10/24)})
 points=sorted(anchors);starts={}
 for i,j in zip(points,points[1:]):
  total=sum(weights[i:j]);start=anchors[i];span=anchors[j]-start;cumulative=0
  for k in range(i,j):starts[k]=start+round(span*cumulative/total);cumulative+=weights[k]
  starts[j]=anchors[j]
 for i,s in enumerate(block):timeline.append({**s,'start_frame':starts[i],'end_frame':starts[i+1],'native':s['id'] in native,'section':section})
timeline += [{'id':'TITLE','start_frame':2880,'end_frame':3168,'native':True,'section':'TITLE'},{'id':'CREDITS','start_frame':25320,'end_frame':26280,'native':True,'section':'CREDITS'}]
timeline.sort(key=lambda s:s['start_frame'])
for s in timeline:s.update(start=s['start_frame']/FPS,end=s['end_frame']/FPS)
assert len(timeline)==152,len(timeline)
assert all(x['end_frame']==y['start_frame'] for x,y in zip(timeline,timeline[1:]))
assert next(x for x in timeline if x['id']=='END-03')['start']==977.5
assert next(x for x in timeline if x['id']=='END-03')['end']==983.5
(ROOT/'project/full_picture_timeline.json').write_text(json.dumps(timeline,ensure_ascii=False,indent=2))
print(json.dumps({'shots':len(timeline),'frames':26280,'duration':1095,'silent_interval':[977.5,983.5]},indent=2))
