from pathlib import Path
import subprocess,json,hashlib
import numpy as np
ROOT=Path(__file__).resolve().parents[1];SR=48000;START=934.8333333333334;END=960.5416666666666
def sha(p):
 with p.open('rb') as f:return hashlib.file_digest(f,'sha256').hexdigest()
def main():
 source=ROOT/'audio/dialogue_candidates/E9_self_lull_melo_candidate.wav'
 target=ROOT/'audio/derived_stems/E9_mirror_voice_timed_B07_v1.wav';target.parent.mkdir(exist_ok=True)
 if target.exists():raise FileExistsError(target)
 raw=subprocess.check_output(['ffmpeg','-v','error','-i',str(source),'-af','atempo=1.185625','-ac','1','-ar',str(SR),'-f','f32le','pipe:1'])
 mono=np.frombuffer(raw,dtype='<f4').copy();mono*=.14/max(float(abs(mono).max()),1e-9)
 # One identical PCM take, no voice cloning and no pitch changes between copies.
 mono=np.round(mono*8388608).astype(np.int32);a=np.column_stack([mono,mono]);out=np.zeros((round((END-START)*SR),2),dtype=np.int32)
 pairs=[(935.508,936.508),(940.19,940.69),(944.364,944.364),(948.717,948.717)];rows=[]
 for screen,real in pairs:
  si=round((screen-START)*SR);ri=round((real-START)*SR)
  out[si:si+len(a)]+=a
  if ri!=si:out[ri:ri+len(a)]+=a
  else:out[si:si+len(a)]+=a
  rows.append({'screen_onset':screen,'reality_onset':real,'delay_samples':ri-si,'delay_seconds':(ri-si)/SR,'same_source_pcm_sha256':hashlib.sha256(a.tobytes()).hexdigest(),'simultaneous_copy_sum':ri==si})
 b=(out<<8).astype('<i4').tobytes()
 subprocess.run(['ffmpeg','-nostdin','-v','error','-f','s32le','-ar',str(SR),'-ac','2','-i','pipe:0','-c:a','pcm_s24le',str(target)],input=b,check=True)
 decoded=np.frombuffer(subprocess.check_output(['ffmpeg','-v','error','-i',str(target),'-c:a','pcm_s32le','-f','s32le','pipe:1']),dtype='<i4').reshape(-1,2)>>8
 assert np.array_equal(decoded,out)
 for row,(screen,real) in zip(rows,pairs):
  si=round((screen-START)*SR);ri=round((real-START)*SR)
  expected=np.zeros_like(out);expected[si:si+len(a)]+=a;expected[ri:ri+len(a)]+=a
  lo=min(si,ri);hi=max(si,ri)+len(a);assert np.array_equal(decoded[lo:hi],expected[lo:hi])
 probe=json.loads(subprocess.check_output(['ffprobe','-v','error','-show_streams','-show_format','-of','json',str(target)]))
 check=subprocess.run(['ffmpeg','-v','error','-xerror','-i',str(target),'-f','null','-'],capture_output=True,text=True);assert check.returncode==0
 report={'status':'EXACT_TIMED_STEM_TECHNICAL_PASS_NOT_FINAL_MIX','source':str(source.relative_to(ROOT)),'source_sha256':sha(source),'output':str(target.relative_to(ROOT)),'sha256':sha(target),'timeline_start':START,'timeline_end':END,'duration':len(decoded)/SR,'take_duration':len(a)/SR,'pairs':rows,'decoded_pcm_bit_exact':True,'decode_exit':check.returncode,'probe':probe,'limitations':['Requires actual synchronized face and mouth animation and full sequence review.','No full-film mix replacement has been selected.'],'generic_synthetic_voice_no_real_person_reference':True}
 (ROOT/'qa/B07_E9_voice_stem_timing.json').write_text(json.dumps(report,indent=2));print(json.dumps(report),flush=True)
if __name__=='__main__':main()
