Replaces nine measured switch transients with one original seeded mechanical click.
Writes independent dry/reverb stems and sample-based tests. Never edits the baseline.
"""
from pathlib import Path
import json,subprocess,hashlib
import numpy as np
from scipy.signal import butter,sosfilt,fftconvolve
ROOT=Path(__file__).resolve().parents[1];SR=48000
def wav(path,a):
 path.parent.mkdir(parents=True,exist_ok=True)
 p=subprocess.run(['ffmpeg','-nostdin','-v','error','-f','f32le','-ar',str(SR),'-ac','2','-i','pipe:0','-c:a','pcm_s24le',str(path)],input=a.astype('<f4').tobytes(),capture_output=True)
 if p.returncode:raise RuntimeError(p.stderr.decode())
def main():
 target=ROOT/'output/SILENT_PROTOCOL_MIX_DERIVED_v2_18M15S.flac'
 if target.exists():raise FileExistsError(target)
 raw=subprocess.check_output(['ffmpeg','-v','error','-i',str(ROOT/'output/SILENT_PROTOCOL_AUDIO_WORKPRINT_18M15S.flac'),'-f','f32le','pipe:1'])
 a=np.frombuffer(raw,dtype='<f4').reshape(-1,2).copy();del raw
 measurements=json.loads((ROOT/'qa/lever_identity_analysis.json').read_text());stems=ROOT/'audio/derived_stems'
 rng=np.random.default_rng(6108);t=np.arange(round(SR*.07))/SR
 click=sosfilt(butter(2,[900,11500],fs=SR,btype='bandpass',output='sos'),rng.normal(size=len(t)))*np.exp(-t*91)
 click+=.35*np.sin(2*np.pi*2310*t)*np.exp(-t*160);click=click/max(abs(click))*.34
 dry=np.column_stack([click,click]);wav(stems/'lever_shared_dry.wav',dry)
 dry_hash=hashlib.sha256(dry.astype('<f4').tobytes()).hexdigest();rows=[]
 for i,m in enumerate(measurements):
  old=round(m['click_onset']*SR);stop=old+len(click)
  # The brief silence occupied by the old impact is reconstructed from adjacent
  # ambient samples. All dialogue outside this 70 ms window remains unchanged.
  l=a[old-1].copy();r=a[stop].copy();ramp=np.linspace(0,1,len(click))[:,None];a[old:stop]=l*(1-ramp)+r*ramp
  onset=m['click_onset']+(1.2 if i in [0,8] else 0)
  rt60=.32+i*.20;nt=round((rt60+.05)*SR);tt=np.arange(nt)/SR
  impulse=rng.normal(size=nt)*np.exp(-6.907755*tt/rt60)
  impulse=sosfilt(butter(2,[160,6800],fs=SR,btype='bandpass',output='sos'),impulse)
  impulse[:round(.06*SR)]=0;impulse=impulse/max(np.linalg.norm(impulse),1e-9)
  wet=fftconvolve(click,impulse)*(.16+.032*i)
  tail=np.column_stack([wet,np.roll(wet,43+i*7)]).astype(np.float32)
  stem=tail.copy();stem[:len(click)]+=dry
  wav(stems/f'lever_{i+1:02d}_rt60_{rt60:.2f}s.wav',stem)
  at=round(onset*SR);a[at:at+len(stem)]+=stem
  rows.append({'number':i+1,'shot':m['shot'],'onset':onset,'old_onset':m['click_onset'],'shared_dry_sha256':dry_hash,'rt60_seconds':rt60,'wet_gain':.16+.032*i,'stem':str((stems/f'lever_{i+1:02d}_rt60_{rt60:.2f}s.wav').relative_to(ROOT))})
 a[round(977.5*SR):round(983.5*SR)]=0
 peak=float(abs(a).max())
 if peak>.94:a*=.94/peak
 p=subprocess.run(['ffmpeg','-nostdin','-v','error','-f','f32le','-ar',str(SR),'-ac','2','-i','pipe:0','-c:a','flac',str(target)],input=a.astype('<f4').tobytes(),capture_output=True)
 if p.returncode:raise RuntimeError(p.stderr.decode())
 check=subprocess.run(['ffmpeg','-v','error','-xerror','-i',str(target),'-f','null','-'],capture_output=True)
 report={'status':'DERIVED_AUDIO_TECHNICAL_QA_PASS_CREATIVE_LISTENING_PENDING','baseline_preserved':True,'duration':len(a)/SR,'peak':float(abs(a).max()),'clipped_samples':int((abs(a)>=1).sum()),'END03_all_zero':bool(np.all(a[round(977.5*SR):round(983.5*SR)]==0)),'decode_exit':check.returncode,'lever_shared_dry_source':'one seeded original procedural mechanical click','lever_events':rows,'dialogue_and_music':'recovered mix retained; language, acting and cue content require creative review'}
 assert check.returncode==0 and report['END03_all_zero'] and len(a)==52560000
 assert all(x['rt60_seconds']<y['rt60_seconds'] for x,y in zip(rows,rows[1:]))
 (ROOT/'qa/derived_audio_validation.json').write_text(json.dumps(report,ensure_ascii=False,indent=2));print(json.dumps(report,ensure_ascii=False),flush=True)
if __name__=='__main__':main()
