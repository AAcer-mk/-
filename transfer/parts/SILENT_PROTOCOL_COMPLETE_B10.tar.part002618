import zipfile,json,hashlib,subprocess,sys
ROOT=Path(__file__).resolve().parents[1]
def sha(p):
 h=hashlib.sha256()
 with p.open('rb') as f:
  for b in iter(lambda:f.read(1048576),b''):h.update(b)
 return h.hexdigest()
def main():
 subprocess.run([sys.executable,str(ROOT/'project/rebuild_manifest.py')],check=True)
 label=sys.argv[1] if len(sys.argv)>1 else 'B03'
 if not label.replace('_','').isalnum():raise ValueError('Invalid checkpoint label')
 (ROOT/'checkpoints').mkdir(exist_ok=True)
 out=ROOT/f'checkpoints/SILENT_PROTOCOL_PRODUCTION_{label}_SOURCE_CHECKPOINT.zip'
 with zipfile.ZipFile(out,'x',compression=zipfile.ZIP_STORED) as z:
  for d in ['art','graphics','audio','evidence','project','docs','subtitles','qa','logs']:
   for p in sorted((ROOT/d).rglob('*')):
    if p.is_file() and '__pycache__' not in p.parts and '.partial' not in p.name:z.write(p,str(p.relative_to(ROOT)))
  for p in (ROOT/'output').glob('*.flac'):z.write(p,str(p.relative_to(ROOT)))
  for f in ['assets_manifest.json','PRODUCTION_STATUS.md']:z.write(ROOT/f,f)
 with zipfile.ZipFile(out) as z:assert z.testzip() is None;count=len(z.infolist())
 receipt={'file':out.name,'bytes':out.stat().st_size,'sha256':sha(out),'entries':count,'CRC':'PASS','scope':'COMPLETE_CURRENT_SOURCE_ENGINE_NOT_COMPLETE_FILM','rendered_MP4':'Saved separately; rebuild from sources using included scripts.','original_rescue_baseline':'Separate immutable rescue ZIP remains preserved.'}
 (ROOT/f'checkpoints/{label}_SOURCE_CHECKPOINT_VERIFICATION.json').write_text(json.dumps(receipt,ensure_ascii=False,indent=2));print(json.dumps(receipt),flush=True)
if __name__=='__main__':main()
