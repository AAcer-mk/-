  {
    "id": "E2-04",
    "camera_and_duration": "6s｜特写",
    "source_scene": "新的标题是「Arthur Pell，享年 79 岁，于 3 月 15 日安详离世」。日期是明天\n‖ 挂钟声停止",
    "start_frame": 6501,
    "end_frame": 6612,
    "native": true,
