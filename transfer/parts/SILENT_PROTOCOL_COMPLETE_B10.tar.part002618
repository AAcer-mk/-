from pathlib import Path
import hashlib,json,zipfile,datetime,sys,zlib,os
ROOT=Path(__file__).resolve().parents[1]
BASE=ROOT/'checkpoints/SILENT_PROTOCOL_PRODUCTION_B05.zip'
EXPECTED='5caed769422c04362976c147c39fd0b5c10fcf7d68937f9bc31a7415b6193165'
def sha(path):
 with path.open('rb') as f:return hashlib.file_digest(f,'sha256').hexdigest()
def main(label):
 if not label.replace('_','').isalnum():raise ValueError(label)
 if sha(BASE)!=EXPECTED:raise RuntimeError('B05 baseline hash mismatch')
 BASE.chmod(0o444)
 out=ROOT/'checkpoints'/f'SILENT_PROTOCOL_{label}_DELTA_FROM_B05.zip'
 if out.exists():raise FileExistsError(out)
 final_out=out;out=out.with_name(out.name+'.partial')
 if out.exists():raise FileExistsError(out)
 files=[]
 for folder in ['art','graphics','audio','project','docs','subtitles','output','qa','logs','evidence','state']:
  files.extend(p for p in (ROOT/folder).rglob('*') if p.is_file() and '__pycache__' not in p.parts and '.partial' not in p.name and '.tmp-' not in p.name and p.name!='writer.lock')
 files.extend([ROOT/'PRODUCTION_STATUS.md',ROOT/'assets_manifest.json'])
 rows=[]
 with zipfile.ZipFile(BASE) as base,zipfile.ZipFile(out,'x',compression=zipfile.ZIP_STORED) as delta:
  names=set(base.namelist())
  for path in sorted(files):
   name=str(path.relative_to(ROOT));data=path.read_bytes();checksum=hashlib.sha256(data).hexdigest()
   if name in names:
    info=base.getinfo(name)
    if info.file_size==len(data) and info.CRC==zlib.crc32(data) and hashlib.sha256(base.read(name)).hexdigest()==checksum:continue
   delta.writestr(name,data);rows.append({'path':name,'bytes':len(data),'sha256':checksum})
  manifest={'kind':'INDEPENDENT_DELTA_NOT_FINAL_FILM','requires_base':'SILENT_PROTOCOL_PRODUCTION_B05.zip','base_sha256':EXPECTED,'created_at':datetime.datetime.now(datetime.timezone.utc).isoformat(),'label':label,'files':rows,'live_logs':'Log files are saved snapshots, not proof that a worker remains running.','restore':'Verify B05 hash, extract into a NEW isolated directory, then apply this verified delta to derived copies. Preserve the B05 archive and old original assets.'}
  delta.writestr('DELTA_MANIFEST.json',json.dumps(manifest,ensure_ascii=False,indent=2))
 with out.open('rb') as f:os.fsync(f.fileno())
 with zipfile.ZipFile(out) as z:
  if z.testzip() is not None:raise RuntimeError('ZIP CRC failed')
  for row in rows:
   if hashlib.sha256(z.read(row['path'])).hexdigest()!=row['sha256']:raise RuntimeError(row['path'])
 os.replace(out,final_out);out=final_out
 fd=os.open(out.parent,os.O_RDONLY)
 try:os.fsync(fd)
 finally:os.close(fd)
 receipt={'checkpoint':str(out),'bytes':out.stat().st_size,'sha256':sha(out),'entries':len(rows)+1,'crc':'PASS','all_changed_entry_sha256':'PASS','requires_B05':EXPECTED,'status':'INDEPENDENT_DELTA_VERIFIED_NOT_FINAL'}
 (ROOT/'checkpoints'/f'{label}_DELTA_receipt.json').write_text(json.dumps(receipt,indent=2))
 (ROOT/'checkpoints'/f'{label}_DELTA_upload.json').write_text(json.dumps({'uploads':[{'local_path':str(out),'purpose':'create_library_file','library_artifact_type':'other'}]}))
 print(json.dumps(receipt),flush=True)
if __name__=='__main__':main(sys.argv[1])
