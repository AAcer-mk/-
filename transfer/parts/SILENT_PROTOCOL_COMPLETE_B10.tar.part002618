import json,zipfile,hashlib,datetime,sys,subprocess
from PIL import Image
from verified_outputs import verified_section
ROOT=Path(__file__).resolve().parents[1]
def hashfile(p):
 h=hashlib.sha256()
 with p.open('rb') as f:
  for b in iter(lambda:f.read(1048576),b''):h.update(b)
 return h.hexdigest()
def checkpoint(label):
 if not label.replace('_','').isalnum():raise ValueError('Invalid checkpoint label')
 (ROOT/'checkpoints').mkdir(exist_ok=True)
 subprocess.run([sys.executable,str(ROOT/'project/rebuild_manifest.py')],check=True)
 manifest=json.loads((ROOT/'assets_manifest.json').read_text())
 old=(ROOT/'PRODUCTION_STATUS.md').read_text()
 (ROOT/'PRODUCTION_STATUS.md').write_text(old+f'\n检查点 {label}：有效候选 {manifest["valid_candidates"]}；最终成片尚未完成。\n')
 out=ROOT/'checkpoints'/f'SILENT_PROTOCOL_PRODUCTION_{label}.zip'
 with zipfile.ZipFile(out,'x',compression=zipfile.ZIP_STORED) as z:
  for d in ['art','graphics','audio','evidence','project','docs','subtitles','output','qa','logs']:
   for p in sorted((ROOT/d).rglob('*')):
    if not p.is_file() or '__pycache__' in p.parts or '.partial' in p.name:continue
    if p.suffix=='.mp4' and p.parent.name=='sections':
     name=p.name.split('_picture')[0];revision=p.name.split('_picture_clean_')[1].split('_1080p')[0]
     qa=ROOT/'qa'/f'{name}_picture_encoding_{revision}.json'
     if not qa.exists():qa=ROOT/'qa'/f'{name}_picture_encoding.json'
     if not verified_section(name,p,qa):continue
    z.write(p,str(p.relative_to(ROOT)))
  for f in ['assets_manifest.json','PRODUCTION_STATUS.md']:z.write(ROOT/f,f)
 with zipfile.ZipFile(out) as z:assert z.testzip() is None
 receipt={'checkpoint':str(out),'bytes':out.stat().st_size,'sha256':hashfile(out),'status':'ZIP_CRC_PASS_NOT_FINAL','valid_candidates':manifest['valid_candidates']}
 (ROOT/'checkpoints'/f'{label}.json').write_text(json.dumps(receipt,indent=2))
 req={'uploads':[{'local_path':str(out),'purpose':'create_library_file','library_artifact_type':'other'}]}
 (ROOT/'checkpoints'/f'{label}_upload.json').write_text(json.dumps(req))
 print(json.dumps(receipt),flush=True)
if __name__=='__main__':checkpoint(sys.argv[1])
