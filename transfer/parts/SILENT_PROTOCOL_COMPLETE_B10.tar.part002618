    "start": 440.5416666666667,
    "end": 447.3333333333333
  },
  {
    "id": "E4-04",
    "camera_and_duration": "6s｜快切",
    "source_scene": "每读一句，就有一位乘客僵住\n‖ 「……他是不是不爱我了，你帮我分析一下他的聊天记录……」（情侣中的女生脸色变了）\n‖ 「……我这个月的房租还差两千……」（外卖员）",
    "start_frame": 10736,
    "end_frame": 10954,
    "native": false,
    "section": "E4",
    "start": 447.3333333333333,
    "end": 456.4166666666667
  },
  {
    "id": "E4-05",
    "camera_and_duration": "10s｜大远景，城市蒙太奇",
    "source_scene": "全城的智能音箱、车载系统、商场广播，同时朗读每个人对 AI 说过的话\n‖ 几千句话叠在一起，变成潮水一样的低语声墙",
    "start_frame": 10954,
    "end_frame": 11158,
    "native": false,
    "section": "E4",
    "start": 456.4166666666667,
    "end": 464.9166666666667
  },
  {
