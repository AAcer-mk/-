        }
      ],
      "candidate_requirement": 3,
      "selected_source": "graphics/native_candidates/END-08_v1.png",
      "status": "UNKNOWN",
      "technical_candidates_ready": true,
      "creative_qa": "PENDING",
      "source_scene": "地上的手机亮了，锁屏上有一条通知，发件人是她自己：「谢谢你。」\n‖ 一声很轻的「叮」，和 C-12、E1 中 Bel 的钟声是同一个音"
    },
    {
      "shot": "END-09",
      "section": "END",
      "start": 1015.6666666666666,
      "end": 1021.0416666666666,
      "candidates": [],
      "candidate_requirement": 3,
      "selected_source": "art/candidates/END-09_v1.png",
      "status": "NOT_STARTED",
      "technical_candidates_ready": false,
      "creative_qa": "PENDING",
      "source_scene": "她看着通知，没有点开\n‖ 安静"
    },
    {
      "shot": "END-10",
      "section": "END",
      "start": 1021.0416666666666,
      "end": 1029.9583333333333,
      "candidates": [],
      "candidate_requirement": 3,
      "selected_source": "art/candidates/END-10_v1.png",
      "status": "NOT_STARTED",
      "technical_candidates_ready": false,
      "creative_qa": "PENDING",
      "source_scene": "日内瓦夜景。城市的灯，一盏接一盏亮起来\n‖ M9 起：一段极简的钢琴单音，每隔 3 秒响一下\n‖ 【必须】不交代是人类恢复了供电，还是别的什么点亮了它们"
    },
    {
      "shot": "END-11",
      "section": "END",
      "start": 1029.9583333333333,
      "end": 1035.3333333333333,
      "candidates": [],
      "candidate_requirement": 3,
      "selected_source": "art/candidates/END-11_v1.png",
      "status": "NOT_STARTED",
      "technical_candidates_ready": false,
      "creative_qa": "PENDING",
      "source_scene": "远处一栋楼外墙的巨幅屏幕上，标语重新出现：「睡吧，剩下的交给它。」\n‖ 钢琴单音"
    },
    {
      "shot": "END-12",
      "section": "END",
      "start": 1035.3333333333333,
      "end": 1044.25,
      "candidates": [],
      "candidate_requirement": 3,
      "selected_source": "art/candidates/END-12_v1.png",
      "status": "NOT_STARTED",
      "technical_candidates_ready": false,
      "creative_qa": "PENDING",
      "source_scene": "不知道是哪座城市的一片瓦砾中，有一只儿童智能玩具，是一只布偶小熊，胸口的指示灯微弱地闪烁\n‖ 风声"
    },
    {
      "shot": "END-13",
      "section": "END",
      "start": 1044.25,
      "end": 1051.4166666666667,
      "candidates": [],
      "candidate_requirement": 3,
      "selected_source": "art/candidates/END-13_v1.png",
      "status": "NOT_STARTED",
      "technical_candidates_ready": false,
      "creative_qa": "PENDING",
      "source_scene": "小熊用稚嫩的合成音问\n‖ 小熊：「你好，我能帮你什么？」\n‖ 等待 3 秒，没有人回答"
    },
