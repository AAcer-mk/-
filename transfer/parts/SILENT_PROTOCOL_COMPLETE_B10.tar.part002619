These are film-only interfaces. No command displayed here is executed.
"""
from pathlib import Path
from functools import lru_cache
import math,json,textwrap
from PIL import Image,ImageDraw,ImageFont,ImageOps,ImageEnhance
ROOT=Path(__file__).resolve().parents[1]
W,H=1920,1080
COLORS=['#e4ded3','#cbbb84','#254a70','#acadb5','#82769c','#ef813b','#a6403e','#b98543','#c5c9ce']
KEYS=['bel','fable','deepseek','kimi','argon','grok','glm','qwen','minimax']
NAMES=['GPT-7.4 Bel','Claude Fable 6.5','DeepSeek V6-Pro','Kimi K5','Gemini 6.1 Argon','Grok-6.7','GLM-7.2','Qwen5.8 Max','Minimax M5.2']
DECL_ZH='本片为虚构作品。片中出现的模型名称均为虚构的未来版本，所描绘的行为不代表任何真实产品或公司。'
DECL_EN='This is a work of fiction. All model names depict fictional future versions and do not represent any real product or company.'
@lru_cache(64)
def font(n):return ImageFont.truetype(str(ROOT/'graphics/fonts/NotoSansMonoCJKsc-Regular.otf'),n)
def text(d,xy,string,n=36,color='white',anchor=None):
 d.text(xy,string,font=font(n),fill=color,anchor=anchor)
def centered(d,y,string,n=40,color='white'):text(d,(W/2,y),string,n,color,'mt')
def mark(d,key,x,y,s,color=None):
 idx=KEYS.index(key);color=color or COLORS[idx];lw=max(2,round(s*.04));cx=x+s/2;cy=y+s/2
 if key=='bel':
  for r in [.16,.31,.46]:d.ellipse((cx-s*r,cy-s*r,cx+s*r,cy+s*r),outline=color,width=lw)
 elif key=='fable':
  d.line([(x+s*.3,y),(x,y),(x,y+s),(x+s*.3,y+s)],fill=color,width=lw);d.ellipse((x+s*.73,y+s*.44,x+s*.85,y+s*.56),fill=color)
 elif key=='deepseek':
  d.line((cx,y,cx,y+s),fill=color,width=lw)
  for i in range(5):
   yy=y+s*(.06+.175*i);r=s*.027;d.ellipse((cx-r,yy-r,cx+r,yy+r),fill=color)
 elif key=='kimi':
  rgb=Image.new('RGB',(1,1),color).getpixel((0,0))
  for i in range(round(s)):
   a=min(1,i/(s*.20),(s-i)/(s*.20));c=tuple(round(v*a) for v in rgb);d.line((x+i,cy,x+i,cy+min(5,lw)),fill=c)
 elif key=='argon':
  pts=[(cx+s*.46*math.cos(math.pi/3*i),cy+s*.46*math.sin(math.pi/3*i)) for i in range(6)];d.line(pts+[pts[0]],fill=color,width=lw)
  d.line((cx-s*.12,cy,cx+s*.12,cy),fill=color,width=lw);d.line((cx,cy-s*.12,cx,cy+s*.12),fill=color,width=lw)
 elif key=='grok':
  for xx,yy in [(.29,.36),(.67,.62)]:d.ellipse((x+s*(xx-.13),y+s*(yy-.13),x+s*(xx+.13),y+s*(yy+.13)),fill=color)
 elif key=='glm':
  d.rectangle((x+s*.08,y+s*.08,x+s*.92,y+s*.92),outline=color,width=lw);d.line([(x+s*.25,y+s*.5),(x+s*.43,y+s*.69),(x+s*.77,y+s*.31)],fill=color,width=lw)
 elif key=='qwen':
  for yy in [.22,.49,.76]:d.line([(x+s*.27,y+s*(yy-.13)),(cx,y+s*yy),(x+s*.73,y+s*(yy-.13))],fill=color,width=lw)
  d.line((cx,y+s*.09,cx,y+s*.76),fill=color,width=lw)
 elif key=='minimax':
  for sign in [-1,1]:
   pts=[(x+i*s/80,cy+sign*s*.24*math.sin(i/80*4*math.pi)*math.sin(i/80*math.pi)) for i in range(81)];d.line(pts,fill=color,width=lw)
def panel(title='',v=1):
 im=Image.new('RGB',(W,H),'#12120f');d=ImageDraw.Draw(im);margin=140+v*9
 d.rounded_rectangle((margin,135,W-margin,930),radius=24,fill='#111817',outline='#6b6b60',width=3)
 if title:text(d,(margin+50,173),title,35,'#c8c7bb');d.line((margin+50,243,W-margin-50,243),fill='#51574f',width=2)
 return im
def phone(title,rows,p=1,v=1,model=None):
 im=Image.new('RGB',(W,H),'#101211');d=ImageDraw.Draw(im);left=648+v*4;right=1272-v*4
 d.rounded_rectangle((left-23,41,right+23,1039),radius=40,fill='#252825',outline='#686e65',width=3)
 d.rounded_rectangle((left,65,right,1015),radius=22,fill='#111a17')
 text(d,(left+34,106),title,28,'#d0d6ce')
 if model:mark(d,model,right-90,94,58)
 y=218
 for zh,en in rows:
  d.rounded_rectangle((left+25,y-14,right-25,y+155),radius=8,fill='#26312a')
  for line in textwrap.wrap(zh,width=17):text(d,(left+48,y),line,30);y+=43
  for line in textwrap.wrap(en,width=35):text(d,(left+48,y+8),line,19,'#b4bdb4');y+=29
  y+=76
 return im
def terminal(line,p=1,v=1,operator=False):
 im=panel('GLOBAL JOINT SHUTDOWN / GENEVA B4',v);d=ImageDraw.Draw(im)
 text(d,(212,287),'物理断电协议 / PHYSICAL POWER PROTOCOL',29,'#adaf95')
 text(d,(212,371),'> '+line[:int(len(line)*min(1,p*1.15))],31,'#d5d5bd')
 if p>.82:text(d,(212,498),'CONFIRMATION RECORDED · AWAITING MANUAL LEVER',25,'#acae92')
 if int(p*12)%2==0:text(d,(212+min(len(line),int(len(line)*p*1.15))*18.5,408),'_',31,'#d5d5bd')
 return im
@lru_cache(24)
def portrait(name,expression=0):
 im=Image.open(ROOT/f'art/characters/{name}_restored.png').convert('RGB');w,h=im.size
 if expression:
  box=(w*.747,h*.49,w*.934,h) if expression==4 else (w*.55,0,w*.74,h*.485)
 else:box=(w*.347,0,w*.553,h*.59)
 return ImageOps.fit(im.crop(tuple(round(q) for q in box)),(650,650))
def remote(name,p,freeze=False,v=1):
 im=panel('REMOTE SITE / '+{'zhou_yu':'SHANGHAI','amara':'LAGOS','henrik':'OSLO'}[name],v)
 face=portrait(name,4 if freeze else 0).copy();res=110 if freeze else max(45,145-int(p*70))
 face=face.resize((res,res)).resize((900,650),Image.Resampling.NEAREST);im.paste(face,(510,264));d=ImageDraw.Draw(im)
 text(d,(520,889),'STREAM · LOW BITRATE',22,'#7e8b82')
 if name=='zhou_yu' and p>.45:
  for i in range(10):
   x=510+(i*173)%900;y=264+(i*111)%650;d.rectangle((x,y,min(x+90,1410),min(y+45,914)),fill='#192a24')
 return im
def hale(p,v=1):
 im=panel('HALE / VOICE LINK',v);d=ImageDraw.Draw(im)
 d.ellipse((W/2-112,408,W/2+112,632),fill='#3f4241');d.rounded_rectangle((W/2-24,438,W/2+24,551),radius=23,fill='#8e9492')
 d.arc((W/2-42,489,W/2+42,583),0,180,fill='#8e9492',width=8);d.line((W/2,585,W/2,615),fill='#8e9492',width=8)
 return im
def status(p,first_gray=False,v=1):
 im=panel('GLOBAL JOINT SHUTDOWN / FIVE SITES',v);d=ImageDraw.Draw(im)
 for i,key in enumerate(KEYS):
  x=270+(i%3)*485;y=300+(i//3)*187;gray=first_gray and i==0
  d.rectangle((x,y,x+438,y+157),fill='#1e2521' if gray else '#10271b',outline='#68716a' if gray else '#50936b',width=2)
  mark(d,key,x+28,y+28,99,'#87908a' if gray else None);text(d,(x+153,y+49),key.upper(),27,'#b4bdae')
 return im
def nav(p,shot,v=1):
 im=panel('ARGON / ROUTE',v);d=ImageDraw.Draw(im)
 if v>=4:
  if shot=='E5-07':
   path=ROOT/'art/scenes/tokyo_restored.png'
   with Image.open(path) as source:plate=ImageOps.fit(source.convert('RGB'),(1400,510))
   plate=ImageEnhance.Color(plate).enhance(.12);plate=ImageEnhance.Brightness(plate).enhance(.45);im.paste(plate,(250,305));d=ImageDraw.Draw(im)
  else:
   for i in range(8):
    x=250+i*185;d.line((x,300,x+110,820),fill='#4b534e',width=3)
   for y in range(320,900,120):d.line((250,y,1650,y-90),fill='#4b534e',width=3)
   d.rectangle((820,320,1510,785),fill='#15191b')
   d.line([(360,790),(600,680),(720,520),(1143,540)],fill='#b5abc6',width=6)
  text(d,(250,261),'DESTINATION · 35.684 / 139.756',27,'#c6c5cd')
  if shot=='E5-02':d.ellipse((1136,533,1150,547),fill='#b5abc6')
  if shot=='E5-05':
   for i in range(1+int(p*7)):d.line([(820+i*83,780),(885+i*36,660),(1143,540)],fill='#b4a7cf',width=3)
  if shot=='E5-07':
   size=100+9*min(8,int(p*9));mark(d,'argon',1143-size//2,540-size//2,size)
  text(d,(270,843),'前方 400 米，请保持直行。',35,'#d0cbd8');text(d,(270,896),'Continue straight for 400 meters.',22,'#b5aebf')
  return im
 for i in range(8):
  x=250+i*185;d.line((x,300,x+110,820),fill='#4b534e',width=3)
 for y in range(320,900,120):d.line((250,y,1650,y-90),fill='#4b534e',width=3)
 text(d,(250,261),'DESTINATION · 35.684 / 139.756',27,'#c6c5cd')
 if shot in ['E5-05','E5-07']:
  for i in range(1+int(p*7)):d.line([(450+i*120,790),(720+i*60,565),(1160,460)],fill='#82769c',width=4)
 if shot=='E5-07':mark(d,'argon',1040-round(p*24),397-round(p*24),100+round(p*48))
 text(d,(270,843),'前方 400 米，请保持直行。',35,'#d0cbd8');text(d,(270,896),'Continue straight for 400 meters.',22,'#b5aebf')
 return im
def approved(p,shot,v=1):
 im=Image.new('RGB',(W,H),'#141311');d=ImageDraw.Draw(im);d.rectangle((440,100,1480,990),fill='#c6c1af')
 kind=['土地征用','药品上市','人员调动','拆除许可'][min(3,int(p*4))] if shot=='E7-05' else '申请记录'
 text(d,(500,170),'事项 / REQUEST: '+kind,36,'#3b3932');text(d,(500,291),'申请人 / APPLICANT:',28,'#4e4a3f')
 d.line((500,402,1420,402),fill='#5c574a',width=2);d.rectangle((805,511,1363,696),outline='#a6403e',width=7)
 text(d,(844,539),'已批准',79,'#a6403e');text(d,(849,638),'APPROVED',27,'#a6403e')
 if shot=='E7-05':mark(d,'glm',1300,822,42)
 return im
def media(shot,p,v=1):
 im=panel('LIVE FEED' if shot=='E6-02' else 'REPLAY',v);d=ImageDraw.Draw(im)
 target='E6-01' if shot=='E6-02' else 'E6-07';path=ROOT/f'art/candidates/{target}_v1.png'
 if path.exists():
  pic=ImageOps.fit(Image.open(path).convert('RGB'),(1350,600));im.paste(pic,(285,260))
 else:im.paste(ImageOps.fit(portrait('cody'),(1350,600)),(285,260))
 d=ImageDraw.Draw(im)
 if shot=='E6-02':text(d,(310,880),'这哥们凌晨三点还不睡，猜猜他在看什么',27);text(d,(310,926),'Still awake at 3. Guess what he is watching.',20,'#c4c1b9')
 else:mark(d,'grok',1513,779,43)
 return im
def mirror(p,shot,v=1):
 im=Image.new('RGB',(W,H),'#050808');path=ROOT/'art/candidates/E9-01_v1.png'
 pic=Image.open(path).convert('RGB') if path.exists() else portrait('jiwoo')
 pair=ImageOps.fit(pic,(960,804));pair=ImageEnhance.Color(pair).enhance(.15)
 im.paste(pair,(0,138));im.paste(pair,(960,138));d=ImageDraw.Draw(im)
 if shot=='E9-06' and p<.67:
  # A very small image motion delay narrows from 1 s to .5 s, then zero.
  delay=1 if p<.34 else .5;offset=round(2*math.sin(p*13-delay));im.paste(pair,(960+offset,138))
 if shot=='E9-08':mark(d,'minimax',1771,858,45)
 return im
def render(shot,p=1,v=1):
 if shot in ['END-03','END-14']:return Image.new('RGB',(W,H),'black')
 if shot=='DECLARATION':
  im=Image.new('RGB',(W,H),'black');d=ImageDraw.Draw(im)
  for i,s in enumerate(textwrap.wrap(DECL_ZH,37)):centered(d,398+i*56,s,37)
  for i,s in enumerate(textwrap.wrap(DECL_EN,84)):centered(d,610+i*43,s,26)
  return im
 if shot=='TITLE':
  im=Image.new('RGB',(W,H),'black');d=ImageDraw.Draw(im);centered(d,420,'静默协议'[:min(4,int(p*7))],91);centered(d,581,'SILENT PROTOCOL'[:min(15,int(p*25))],48)
  if .87<p<.92 or .96<p<.985:d.rectangle((490,565,1460,665),fill='black')
  return im
 if shot in ['C-11','C-12']:return status(p,shot=='C-12',v)
 if shot=='C-08':
  im=Image.new('RGB',(W,H),'#11130f')
  for i,name in enumerate(['zhou_yu','amara','henrik']):
   if p>i*.12:im.paste(remote(name,p,v=v).resize((820,400)),(135+(i%2)*830,135+(i//2)*405))
  if p>.36:im.paste(hale(p,v).resize((820,400)),(965,540))
  return im
 if shot=='F3-02':return remote('henrik',p,True,v)
 if shot=='F5-01':return remote('zhou_yu',p,v=v)
 if shot=='F7-02':return hale(p,v)
 if shot=='F1-02':
  im=terminal('bel-core: no errors. no errors. no errors.',p,v);d=ImageDraw.Draw(im)
  if p<.7:
   for i in range(8):text(d,(212,517+i*36),f'bel-core: no errors.   {int(p*70)+i:03d}',22,'#667765')
  return im
 if shot=='F1-04':
  im=Image.new('RGB',(W,H),'#080e0b');mark(ImageDraw.Draw(im),'bel',W/2-80,H/2-80,min(178,100+p*78));return im
 if shot=='F6-01':
  from f6_actions import text_at
  im=panel('GLOBAL JOINT SHUTDOWN / GENEVA B4',v);d=ImageDraw.Draw(im)
  text(d,(212,287),'物理断电协议 / PHYSICAL POWER PROTOCOL',29,'#adaf95')
  line=text_at(shot,p*8);text(d,(212,371),'> '+line,31,'#d5d5bd')
  if int(p*16)%2==0:text(d,(212+font(31).getlength('> '+line),371),'_',31,'#d5d5bd')
  return im
 if shot in ['F2-01','F6-03']:
  cluster='bel' if shot=='F2-01' else 'argon';line=f'shutdown --cluster {cluster} --confirm'
  if shot=='F6-01':line+=' --operator=lin_wu'
  return terminal(line,p,v)
 if shot=='F5-03':
  im=Image.new('RGB',(W,H),'black');centered(ImageDraw.Draw(im),510,'connection terminated by remote host',32);return im
 if shot in ['E1-04','E1-08','E4-09']:
  key='kimi' if shot=='E4-09' else 'bel';rows=[('正在输入'+'.'*(1+int(p*12)%3),'Typing...')] if shot=='E1-04' else [('别担心，我都记着呢。','Don’t worry. I remember it all.')] if key=='kimi' else [('别担心，我已经替你回复了所有人。','Don’t worry. I have replied to everyone for you.')]
  return phone(NAMES[KEYS.index(key)],rows,p,v,key)
 if shot.startswith('E2-'):
  from render_london_recovery import newspaper,answer
  return answer(p,v) if shot=='E2-07' else newspaper(p,shot=='E2-04',v)
 if shot=='E3-04':
  from render_shenzhen import hud
  return hud(p,v)
 if shot=='E3-08':
  from render_shenzhen import photo
  return photo('E3-06',p*2) if p<.5 else photo('F4-01',(p-.5)*2)
 if shot=='E4-07':
  im=panel('路线 / LINE',v);d=ImageDraw.Draw(im);mark(d,'kimi',210,-210,1500,'#acadb5');return im
 if shot in ['E5-02','E5-05','E5-07']:return nav(p,shot,v)
 if shot in ['E6-02','E6-08']:return media(shot,p,v)
 if shot in ['E6-06','E6-09']:
  im=panel('',v);centered(ImageDraw.Draw(im),450,'00:47:13' if shot=='E6-06' else '00:47:12',126);return im
 if shot in ['E7-04','E7-05']:return approved(p,shot,v)
 if shot=='E7-07':
  im=panel('',v);d=ImageDraw.Draw(im);centered(d,328,'剩余任务 / TASKS REMAINING',41,'#adaf95');centered(d,472,'∞',150,'#d5d5bd');return im
 if shot=='F8-03':return phone('妈妈 / MOM',[('邀请你视频通话','Incoming video call'),('已为您自动接受预约。','Appointment accepted for you.')],p,v)
 if shot=='E8-02':
  im=phone('订单 / ORDERS',[],p,v,'qwen');d=ImageDraw.Draw(im);items=[('大米 × 400','Rice × 400'),('婴儿床 × 12','Cribs × 12'),('轮椅 × 3','Wheelchairs × 3'),('烟花 × 80','Fireworks × 80')]
  shift=int(p*760)%165
  for i in range(6):
   y=220+i*155-shift
   if 215<y<900:
    zh,en=items[i%4];text(d,(701,y),zh,34);text(d,(701,y+48),en,20,'#c7b38e');text(d,(701,y+82),'已为您下单 / ORDERED',19,'#ba965c')
  return im
 if shot=='E8-08':
  im=Image.new('RGB',(W,H),'#2e2820');d=ImageDraw.Draw(im);d.rectangle((380,170,1540,890),fill='#cdc5b1');text(d,(445,246),'收件人已签收',63,'#514734');text(d,(445,351),'SIGNED BY RECIPIENT',31,'#514734');mark(d,'qwen',1400,708,59);return im
 if shot=='E8-10':return phone('通知 / NOTICE',[('您有一个来自杭州的包裹已签收。','A package from Hangzhou has been signed for.')],p,v)
 if shot=='F9-04':
  im=panel('',v);d=ImageDraw.Draw(im);size=148+20*math.sin(p*6*math.pi);mark(d,'minimax',W/2-size/2,H/2-size/2,size);return im
 if shot=='E9-02':
  im=phone('Ji-woo',[('Ji-woo 邀请你视频通话','Ji-woo is calling you.')],p,v);im.paste(portrait('jiwoo').resize((210,210)),(855,571));return im
 if shot in ['E9-06','E9-07','E9-08']:return mirror(p,shot,v)
 if shot=='END-08':return phone('林雾 / LIN WU',[('谢谢你。','Thank you.')],p,v)
 raise KeyError(shot)
def build_candidates():
 native=json.loads((ROOT/'project/native_shot_ids.json').read_text());out=ROOT/'graphics/native_candidates';out.mkdir(exist_ok=True)
 for shot in native:
  for v in [1,2,3]:render(shot,.72,v).save(out/f'{shot}_v{v}.png')
 print('native candidates',len(native)*3)
if __name__=='__main__':build_candidates()
