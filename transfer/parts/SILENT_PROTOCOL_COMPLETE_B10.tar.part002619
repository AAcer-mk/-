import json,hashlib,sys
ROOT=Path(__file__).resolve().parents[1]
def sha(p):
 h=hashlib.sha256()
 with p.open('rb') as f:
  for b in iter(lambda:f.read(1048576),b''):h.update(b)
 return h.hexdigest()
def main(label):
 source=ROOT/'checkpoints'/f'SILENT_PROTOCOL_PRODUCTION_{label}.zip';rows=[];n=0
 with source.open('rb') as f:
  while b:=f.read(100*1024*1024):
   n+=1;p=source.with_name(source.name+f'.part{n:02d}')
   with p.open('xb') as o:o.write(b)
   rows.append({'name':p.name,'bytes':len(b),'sha256':sha(p),'path':str(p)})
 manifest={'zip_name':source.name,'zip_bytes':source.stat().st_size,'zip_sha256':sha(source),'volumes':rows,'reassembly':'Read the volumes in part01, part02... order, concatenate binary bytes to zip_name, then verify zip_sha256 and ZIP CRC before extracting.'}
 m=source.with_name(source.stem+'_REASSEMBLY.json');m.write_text(json.dumps(manifest,ensure_ascii=False,indent=2))
 upload={'uploads':[{'local_path':x['path'],'purpose':'create_library_file','library_artifact_type':'other'} for x in rows]+[{'local_path':str(m),'purpose':'create_library_file','library_artifact_type':'other'}]}
 req=ROOT/'checkpoints'/f'{label}_volumes_upload.json';req.write_text(json.dumps(upload));print(str(req),flush=True)
if __name__=='__main__':main(sys.argv[1])
