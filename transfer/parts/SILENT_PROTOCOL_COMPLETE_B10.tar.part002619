  report={'mode':'CHECK_ONLY_NO_ENCODERS_STARTED','sections':[{'section':s,'candidates_ready':ready(s)} for s in pending]}
  (ROOT/'qa/render_readiness_resume.json').write_text(json.dumps(report,indent=2))
  print(json.dumps(report),flush=True);return
