import json,hashlib
from PIL import Image
from film_compositor import CHOICES,candidate_variants
from verified_outputs import verified_section,section_record
ROOT=Path(__file__).resolve().parents[1]
def sha(p):
 h=hashlib.sha256()
 with p.open('rb') as f:
  for b in iter(lambda:f.read(1048576),b''):h.update(b)
 return h.hexdigest()
def main():
 timeline=json.loads((ROOT/'project/full_picture_timeline.json').read_text());rows=[]
 for s in timeline:
  card=s['id'].endswith('-CARD') or s['id'] in ['TITLE','DECLARATION','CREDITS'];candidates=[]
  directory='graphics/native_candidates' if s['native'] else 'art/candidates'
  for v in candidate_variants(s['id']):
   p=ROOT/directory/f"{s['id']}_v{v}.png"
   if not p.exists():continue
   try:
    with Image.open(p) as im:im.load();size=im.size
    candidates.append({'path':str(p.relative_to(ROOT)),'sha256':sha(p),'bytes':p.stat().st_size,'dimensions':size,'decode':'PASS'})
   except Exception as e:candidates.append({'path':str(p.relative_to(ROOT)),'decode':'FAIL','error':str(e)})
  v=CHOICES.get(s['id'],1);pic,picqa=section_record(s['section']);rendered=verified_section(s['section'])
  row={'shot':s['id'],'section':s['section'],'start':s['start'],'end':s['end'],'candidates':candidates,'candidate_requirement':0 if card else 3,'source_scene':s.get('source_scene'),'selected_source':str((ROOT/directory/f"{s['id']}_v{v}.png").relative_to(ROOT)) if not card else 'project/native_scenes.py or film_compositor.py','output_picture':str(pic.relative_to(ROOT)) if rendered else None,'encoding_qa':str(picqa.relative_to(ROOT)) if rendered else None,'status':'RENDERED_CREATIVE_QA_PENDING' if rendered else 'CANDIDATES_READY' if card or sum(x['decode']=='PASS' for x in candidates)>=3 else 'BLOCKED_MISSING_CANDIDATES','creative_qa':'PENDING','known_issues':[]}
  independent=ROOT/f'qa/{s["id"]}_encoding_v1.json'
  if independent.is_file():
   a=json.loads(independent.read_text());o=ROOT/a['output']
   if o.is_file() and sha(o)==a['sha256'] and a['decode_exit']==0:
    row['independent_picture_output']=a['output'];row['independent_picture_qa']=str(independent.relative_to(ROOT));row['status']='INDEPENDENT_SHOT_ENCODED_SECTION_PENDING';row['creative_qa']=a['creative_qa']
  if s['id']=='E1-07':row['known_issues'].append('Montage identity/geography needs revision; additional Imagegen attempt was blocked by quota.')
  if s['id']=='E4-03':row['known_issues'].append('Current candidates focus Xiaoman; original shot calls for office worker reaction. Needs editorial repair.')
  if s['id']=='E9-07':row['known_issues'].append('Damaged PNG repaired in derivative copy; apartment/character matching must be updated after E9-01 is generated.')
  if s['section'].startswith('F') and not s['native']:row['known_issues'].append('Physical monitor and lever counts require continuity review; no full-film pass claimed.')
  rows.append(row)
 report={'status':'IN_PRODUCTION_NOT_FINAL','segments':len(rows),'camera_shots':140,'physical_shots':97,'native_camera_shots':43,'valid_candidates':sum(x['decode']=='PASS' for r in rows for x in r['candidates']),'missing_physical_candidates':sum(max(0,3-sum(x['decode']=='PASS' for x in r['candidates'])) for r in rows if not next(s['native'] for s in timeline if s['id']==r['shot'])),'shots':rows}
 (ROOT/'assets_manifest.json').write_text(json.dumps(report,ensure_ascii=False,indent=2));print({k:v for k,v in report.items() if k!='shots'},flush=True)
if __name__=='__main__':main()
