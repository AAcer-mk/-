from pathlib import Path
import subprocess,time,json,sys,argparse
from PIL import Image
from verified_outputs import verified_section
from film_compositor import candidate_variants,CHOICES,LAYOUTS,MONTAGE_REQUIRED
ROOT=Path(__file__).resolve().parents[1]
TL=json.loads((ROOT/'project/full_picture_timeline.json').read_text())
names=['E4','F5','E5','F6','E6','F7','E7','F8','E8','F9','E9','END','CREDITS']
def ready(sec):
 for s in TL:
  if s['section']==sec and not s['native']:
   if s['id'] in MONTAGE_REQUIRED and s['id'] not in LAYOUTS:return False
   for v in set(candidate_variants(s['id'])+[CHOICES.get(s['id'],1)]):
    p=ROOT/'art/candidates'/f"{s['id']}_v{v}.png"
    if not p.exists():return False
    try:
     with Image.open(p) as im:im.load()
    except (OSError,ValueError):return False
 return True
