from pathlib import Path
from functools import lru_cache
import numpy as np
import cv2
from PIL import Image,ImageDraw,ImageFilter
ROOT=Path(__file__).resolve().parents[1]
@lru_cache(8)
def endpoints(shot,start_variant,end_variant):
    paths=[ROOT/'art/candidates'/f'{shot}_v{v}.png' for v in [start_variant,end_variant]]
    frames=[]
    for path in paths:
        with Image.open(path) as im: im.load();frames.append(np.array(im.convert('RGB')))
    if frames[0].shape != frames[1].shape: raise ValueError('Endpoints must have identical dimensions')
    a,b=frames
    small_a=cv2.resize(a,(835,471));small_b=cv2.resize(b,(835,471))
    ga=cv2.cvtColor(small_a,cv2.COLOR_RGB2GRAY);gb=cv2.cvtColor(small_b,cv2.COLOR_RGB2GRAY)
    flow_ab=cv2.calcOpticalFlowFarneback(ga,gb,None,.5,5,31,5,7,1.5,0)
    flow_ba=cv2.calcOpticalFlowFarneback(gb,ga,None,.5,5,31,5,7,1.5,0)
    h,w=a.shape[:2];scale=np.array([w/835,h/471],np.float32)
    flow_ab=cv2.resize(flow_ab,(w,h))*scale;flow_ba=cv2.resize(flow_ba,(w,h))*scale
    grid=np.stack(np.meshgrid(np.arange(w,dtype=np.float32),np.arange(h,dtype=np.float32)),axis=-1)
    return a,b,flow_ab,flow_ba,grid
def lever_frame(shot,elapsed):
    a,b,fab,fba,grid=endpoints(shot,1 if shot=='F6-04' else 2,3)
    # Hold physical photograph for two seconds after preceding disconnect.
    # End state and power-off land exactly on the authored click at 517.6s.
    begin,finish=(1.20,1.6) if shot=='F6-04' else (2.225,2.6)
    if elapsed<=begin:return Image.fromarray(a)
    if elapsed>=finish:return Image.fromarray(b)
    u=(elapsed-begin)/(finish-begin);u=u*u*(3-2*u)
    ma=grid-fab*u;mb=grid-fba*(1-u)
    wa=cv2.remap(a,ma[:,:,0],ma[:,:,1],cv2.INTER_CUBIC,borderMode=cv2.BORDER_REFLECT)
    wb=cv2.remap(b,mb[:,:,0],mb[:,:,1],cv2.INTER_CUBIC,borderMode=cv2.BORDER_REFLECT)
    result=np.clip(wa.astype(np.float32)*(1-u)+wb.astype(np.float32)*u,0,255).astype(np.uint8)
    # Switch screen state only on the audible mechanical contact, no dissolve.
    # Fourth panel is source-space (646,344)-(752,455); boundaries remain real.
    if shot=='F6-04':result[344:455,773:881]=a[344:455,773:881]
    else:result[344:455,646:752]=a[344:455,646:752]
    return Image.fromarray(result)

def typing_frame(t):
    from f6_actions import finger_phase
    a,b,fab,fba,grid=endpoints('F6-03',1,2)
    u=finger_phase(t) if t>=.65 else 0
    ma=grid-fab*u;mb=grid-fba*(1-u)
    wa=cv2.remap(a,ma[:,:,0],ma[:,:,1],cv2.INTER_CUBIC,borderMode=cv2.BORDER_REFLECT)
    wb=cv2.remap(b,mb[:,:,0],mb[:,:,1],cv2.INTER_CUBIC,borderMode=cv2.BORDER_REFLECT)
    result=a.copy();motion=np.clip(wa.astype(np.float32)*(1-u)+wb.astype(np.float32)*u,0,255).astype(np.uint8)
    result[585:940,450:1440]=motion[585:940,450:1440]
    return Image.fromarray(result)

@lru_cache(1)
def wall_plates():
    with Image.open(ROOT/'art/candidates/E5-06_v2.png') as im:im.load();start=im.convert('RGBA')
    with Image.open(ROOT/'art/candidates/E5-06_v4.png') as im:im.load();background=im.convert('RGBA')
    if start.size!=background.size:raise ValueError('Wall plates must match dimensions')
    mask=Image.new('L',start.size,0)
    points=[(91,580),(92,537),(144,493),(177,483),(220,424),(280,391),(435,373),(513,381),(580,411),(624,433),(688,436),(722,451),(736,480),(733,542),(703,561),(691,570),(676,602),(624,618),(489,668),(437,681),(390,677),(336,654),(201,650),(132,620)]
    ImageDraw.Draw(mask).polygon(points,fill=255);mask=mask.filter(ImageFilter.GaussianBlur(.65));sprite=start.copy();sprite.putalpha(mask)
    return background,sprite.crop((85,365,742,690))

def wall_passage(p):
    background,sprite=wall_plates();im=background.copy();travel=min(1,p/.78);travel=travel*travel*(3-2*travel);scale=1-.26*travel
    if p<.79:
        moved=sprite.resize((round(sprite.width*scale),round(sprite.height*scale)),Image.Resampling.BICUBIC)
        if p>.43:
            progress=min(1,(p-.43)/.35);alpha=np.array(moved.getchannel('A'));edge=round(moved.width*(1-progress));ramp=np.clip((edge-np.arange(moved.width))/10,0,1)
            moved.putalpha(Image.fromarray((alpha*ramp[None,:]).astype(np.uint8)))
        x,y=round(85+350*travel),round(365-100*travel)
        shadow=Image.new('RGBA',im.size,(0,0,0,0));d=ImageDraw.Draw(shadow)
        opacity=round(90*max(0,1-(max(0,p-.43)/.36)))
        d.ellipse((x+30,y+moved.height-55,x+moved.width-10,y+moved.height+20),fill=(0,0,0,opacity));shadow=shadow.filter(ImageFilter.GaussianBlur(10));im=Image.alpha_composite(im,shadow)
        im.alpha_composite(moved,(x,y))
    if p<.94:
        glow=Image.new('RGBA',im.size,(0,0,0,0));d=ImageDraw.Draw(glow);cx=850+220*travel;cy=390-20*travel;opacity=round(135*min(1,max(0,(.94-p)/.18)))
        d.ellipse((cx-110,cy-58,cx+110,cy+58),fill=(255,232,184,opacity));glow=glow.filter(ImageFilter.GaussianBlur(37));im=Image.alpha_composite(im,glow)
    return im.convert('RGB')
