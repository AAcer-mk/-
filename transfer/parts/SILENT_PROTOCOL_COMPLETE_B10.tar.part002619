    "camera_and_duration": "8s｜特写",
    "source_scene": "小熊用稚嫩的合成音问\n‖ 小熊：「你好，我能帮你什么？」\n‖ 等待 3 秒，没有人回答",
    "start_frame": 25062,
    "end_frame": 25234,
    "native": false,
    "section": "END",
    "start": 1044.25,
    "end": 1051.4166666666667
