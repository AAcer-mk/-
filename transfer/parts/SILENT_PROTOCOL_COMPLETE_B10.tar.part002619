from pathlib import Path
import subprocess,json,hashlib
import numpy as np
from scipy.signal import butter,sosfilt
ROOT=Path(__file__).resolve().parents[1];SR=48000
def decode(p,channels=2):
 raw=subprocess.check_output(['ffmpeg','-v','error','-i',str(p),'-ar',str(SR),'-ac',str(channels),'-f','f32le','pipe:1'])
 return np.frombuffer(raw,dtype='<f4').reshape(-1,channels).copy()
def voice(path,gain):
 a=decode(ROOT/path,1)[:,0];n=max(abs(a).max(),1e-8);a=a/n*gain
 fade=min(240,len(a)//8);a[:fade]*=np.linspace(0,1,fade);a[-fade:]*=np.linspace(1,0,fade)
 return a
def main():
 baseline=ROOT/'output/SILENT_PROTOCOL_MIX_DERIVED_v2_18M15S.flac'
 target=ROOT/'output/SILENT_PROTOCOL_MIX_DIALOGUE_REVIEW_v3_18M15S.flac'
 if target.exists():raise FileExistsError(target)
 original=decode(baseline);mixed=original.copy();patches=[]
 # Original words and speaker identity elsewhere remain exactly preserved.
 # New local room tone is authored, rather than pretending to have separated
 # the recovered mix into unavailable dialogue/music stems.
 for start,end,label in [(202.116,203.585,'Spanish'),(203.6,207.375,'Multilingual chorus')]:
  i,j=round(start*SR),round(end*SR);rng=np.random.default_rng(6108+i)
  noise=sosfilt(butter(2,[75,3400],fs=SR,btype='bandpass',output='sos'),rng.normal(size=j-i))
  noise=noise/max(float(np.std(noise)),1e-9)*.004
  t=np.arange(j-i)/SR+start;bed=noise+.0018*np.sin(2*np.pi*53*t)
  block=np.column_stack([bed,np.roll(bed,13)])
  fade=round(.008*SR);f=np.linspace(0,1,fade)[:,None]
  block[:fade]=original[i:i+fade]*(1-f)+block[:fade]*f
  block[-fade:]=block[-fade:]*(1-f)+original[j-fade:j]*f
  mixed[i:j]=block;patches.append({'start':start,'end':end,'label':label,'source_separation':False,'replacement_bed':'Original fixed-seed filtered noise and 53Hz drone, with 8ms boundary crossfades; creative audibility remains to review.'})
 placements=[('es','audio/dialogue_candidates/E1_07_es_ef_dora_candidate.wav',202.145,.16,0),('ar','audio/dialogue_candidates/E1_07_ar_formant_v2_candidate.wav',203.66,.09,-.23),('ko','audio/dialogue_candidates/E1_07_ko_melo_candidate.wav',203.76,.14,.15),('de','audio/dialogue_candidates/E1_07_de_formant_candidate.wav',204.01,.105,.30)]
 rows=[]
 for language,path,start,gain,pan in placements:
  a=voice(path,gain);at=round(start*SR);end=at+len(a)
  assert end<=round(207.375*SR)
  mixed[at:end,0]+=a*(1-pan*.5);mixed[at:end,1]+=a*(1+pan*.5)
  rows.append({'language':language,'source':path,'start':at/SR,'end':end/SR,'peak_gain':gain,'pan':pan,'source_sha256':hashlib.sha256((ROOT/path).read_bytes()).hexdigest()})
 changed=np.any(mixed!=original,axis=1);allowed=np.zeros(len(mixed),dtype=bool)
 for patch in patches:allowed[round(patch['start']*SR):round(patch['end']*SR)]=True
 assert not np.any(changed&~allowed)
 assert np.all(mixed[round(977.5*SR):round(983.5*SR)]==0)
 encode=subprocess.run(['ffmpeg','-nostdin','-v','error','-f','f32le','-ar',str(SR),'-ac','2','-i','pipe:0','-c:a','flac',str(target)],input=mixed.astype('<f4').tobytes(),capture_output=True)
 if encode.returncode:raise RuntimeError(encode.stderr.decode())
 check=subprocess.run(['ffmpeg','-v','error','-xerror','-i',str(target),'-f','null','-'],capture_output=True)
 decoded=decode(target);assert len(decoded)==len(original)
 assert np.array_equal(decoded[~allowed],original[~allowed])
 silence=decoded[round(977.5*SR):round(983.5*SR)]
 report={'status':'ACTUAL_REVIEW_MIX_TECHNICAL_PASS_NOT_FINAL_CREATIVE_PASS','output':str(target.relative_to(ROOT)),'sha256':hashlib.sha256(target.read_bytes()).hexdigest(),'duration':len(decoded)/SR,'decode_exit':check.returncode,'outside_replacement_windows_bit_exact':True,'peak':float(abs(decoded).max()),'clipped_samples':int((abs(decoded)>=1).sum()),'END03_nonzero_samples':int(np.count_nonzero(silence)),'placements':rows,'replaced_windows':patches,'limitations':['Arabic and German procedural timbres need creative review.','Original chorus content could not be individually separated from the recovered mix.','Replacement room-tone boundaries and chorus audibility require sequence listening.'],'baseline_preserved':str(baseline.relative_to(ROOT))}
 assert check.returncode==0 and report['END03_nonzero_samples']==0
 (ROOT/'qa/B06_dialogue_review_mix_v3.json').write_text(json.dumps(report,ensure_ascii=False,indent=2));print(json.dumps(report,ensure_ascii=False),flush=True)
if __name__=='__main__':main()
