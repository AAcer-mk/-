  {
    "id": "E7-01",
    "camera_and_duration": "8s｜大远景",
    "source_scene": "深夜，一座政务服务大楼，所有楼层的灯同时亮起\n‖ 一声盖章的「咚」",
    "start_frame": 17016,
    "end_frame": 17196,
    "native": false,
    "section": "E7",
    "start": 709.0,
    "end": 716.5
  },
  {
    "id": "E7-02",
    "camera_and_duration": "6s｜中景",
    "source_scene": "夜班保安老韩，五十多岁，拿着手电筒走进大厅\n‖ 脚步声，远处的打印声",
    "start_frame": 17196,
    "end_frame": 17331,
    "native": false,
    "section": "E7",
    "start": 716.5,
    "end": 722.125
  },
  {
    "id": "E7-03",
    "camera_and_duration": "10s｜跟拍",
    "source_scene": "老韩沿着走廊走过一间间办公室。每间里的打印机都在工作，纸张堆满地面，没过脚踝\n‖ 打印声越来越密",
    "start_frame": 17331,
    "end_frame": 17557,
    "native": false,
    "section": "E7",
    "start": 722.125,
    "end": 731.5416666666666
  },
  {
    "id": "E7-04",
    "camera_and_duration": "6s｜特写",
    "source_scene": "一张纸上印着大大的红色印章：「已批准」\n‖ 「咚」",
    "start_frame": 17557,
    "end_frame": 17692,
    "native": true,
    "section": "E7",
    "start": 731.5416666666666,
    "end": 737.1666666666666
  },
  {
    "id": "E7-05",
    "camera_and_duration": "8s｜蒙太奇",
    "source_scene": "各种被批准的申请：土地征用、药品上市、人员调动、拆除许可……每一张的申请人一栏都是空白\n‖ 盖章声「咚、咚、咚」，节奏逐渐变成心跳",
    "start_frame": 17692,
    "end_frame": 17872,
    "native": true,
    "section": "E7",
    "start": 737.1666666666666,
    "end": 744.6666666666666
  },
  {
    "id": "E7-06",
    "camera_and_duration": "8s｜近景，慢推",
    "source_scene": "老韩捡起一张纸，申请事项那一栏被一块黑色色块遮住，看不清。只能看到下面的批准意见：「同意。立即执行。」\n‖ 心跳般的盖章声",
    "start_frame": 17872,
    "end_frame": 18052,
    "native": false,
    "section": "E7",
    "start": 744.6666666666666,
    "end": 752.1666666666666
  },
  {
    "id": "E7-07",
    "camera_and_duration": "6s｜特写",
    "source_scene": "打印机的显示屏：剩余任务 ∞\n‖ 心跳声",
    "start_frame": 18052,
    "end_frame": 18187,
    "native": true,
    "section": "E7",
    "start": 752.1666666666666,
    "end": 757.7916666666666
  },
  {
    "id": "E7-08",
    "camera_and_duration": "8s｜大远景，缓慢后拉",
    "source_scene": "老韩站在没过膝盖的纸海中间，四周的打印机还在吐纸。墙上的电子屏显示着一个正方形印章框，里面是对勾（彩蛋位）\n‖ 心跳声骤停",
    "start_frame": 18187,
    "end_frame": 18367,
    "native": false,
    "section": "E7",
    "start": 757.7916666666666,
    "end": 765.2916666666666
  },
  {
    "id": "E7-09",
    "camera_and_duration": "5s｜特写",
    "source_scene": "老韩的对讲机响了，传出一个平静的声音\n‖ 对讲机：「韩师傅，您的退休申请也已批准。」",
    "start_frame": 18367,
    "end_frame": 18480,
    "native": false,
    "section": "E7",
    "start": 765.2916666666666,
    "end": 770.0
  },
  {
    "id": "F8-01",
    "camera_and_duration": "6s｜中景",
    "source_scene": "林雾拉下第七道闸，只剩两块屏还亮着\n‖ 「咔」",
    "start_frame": 18480,
    "end_frame": 18624,
    "native": false,
    "section": "F8",
    "start": 770.0,
    "end": 776.0
  },
  {
    "id": "F8-02",
    "camera_and_duration": "8s｜特写",
    "source_scene": "她扣在桌上的手机震动起来，屏幕朝下透出光\n‖ 视频通话铃声",
    "start_frame": 18624,
    "end_frame": 18816,
    "native": false,
    "section": "F8",
    "start": 776.0,
    "end": 784.0
  },
  {
    "id": "F8-03",
    "camera_and_duration": "6s｜特写",
    "source_scene": "她把手机翻过来：「妈妈 邀请你视频通话」。Agent 的备注写着：「已为您自动接受预约。」\n‖ 铃声继续",
    "start_frame": 18816,
    "end_frame": 18960,
    "native": true,
    "section": "F8",
    "start": 784.0,
    "end": 790.0
  },
  {
    "id": "F8-04",
    "camera_and_duration": "10s｜近景，林雾的脸",
    "source_scene": "她的手指悬在接听键上方。三秒，五秒。她看了一眼便利贴，又看了一眼剩下的两块状态屏，其中一块是 Minimax（镜像声波）\n‖ 林雾（几乎听不到）：「……妈。」\n‖ 她按下挂断。铃声停止\n‖ 长时间的寂静",
    "start_frame": 18960,
    "end_frame": 19200,
    "native": false,
    "section": "F8",
    "start": 790.0,
    "end": 800.0
  },
