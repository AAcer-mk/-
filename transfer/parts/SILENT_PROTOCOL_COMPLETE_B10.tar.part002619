with c.lock():
 with Image.open(source) as im:im.load();dimensions=list(im.size)
 with source.open('rb') as f,target.open('xb') as out:shutil.copyfileobj(f,out);out.flush();os.fsync(out.fileno())
 record={'shot':shot,'variant':variant,'path':str(target.relative_to(c.ROOT)),'bytes':target.stat().st_size,'sha256':c.sha(target),'dimensions':dimensions,'png_read':'PASS','prompt':req['prompt'],'tool_output_path':str(source),'at':c.utc(),'method':'builtin_image_gen','creative_review':req.get('creative_review','PENDING')}
 batch=req.get('batch','B09')
 c.atomic(c.ROOT/f'docs/generation_prompts/{batch}_{shot}_v{variant}.json',record)
 s=c.load();task=next(t for t in s['tasks'] if t['id']==f'generate:{shot}');task['status']='UNKNOWN';task['output']=sorted(set(task['output']+[record['path']]));task['last_saved_asset']=record;c.save(s,'generated_asset_saved:'+shot+':'+str(variant));print(json.dumps(record,ensure_ascii=False))
␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀project/render_independent_shot.py␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀0000644␀0000000␀0000000␀00000004475␀00000000000␀014670␀ 0␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀ustar␀00␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀"""Persist and verify one shot; never count it as a completed section or film."""
import argparse,json,subprocess,time,hashlib
from pathlib import Path
import film_compositor as film
def render(shot,revision):
 s=film.LOOKUPS[shot]
 if not s.get('native'):
  vs=film.candidate_variants(shot)
  if len(vs)<3:raise RuntimeError('Three candidates required')
  for v in vs:film.source(shot,v).load()
 out=film.ROOT/'output/shots';out.mkdir(exist_ok=True)
 target=out/f'{shot}_picture_{revision}_1080p.mp4'
 if target.exists():raise FileExistsError(target)
 partial=target.with_name(target.stem+'.partial.mp4')
 if partial.exists():raise FileExistsError(partial)
 filters='noise=alls=1:allf=t+u,vignette=PI/5,chromashift=cbh=1:crh=-1'
 proc=subprocess.Popen(['ffmpeg','-nostdin','-v','error','-f','rawvideo','-pix_fmt','rgb24','-s','1920x1080','-r','24','-i','pipe:0','-an','-vf',filters,'-c:v','libx264','-crf','19','-preset','veryfast','-threads','3','-pix_fmt','yuv420p','-movflags','+faststart',str(partial)],stdin=subprocess.PIPE)
 n=s['end_frame']-s['start_frame'];started=time.time()
 try:
  for i in range(n):proc.stdin.write(film.frame(s,i/max(1,n-1),(s['start_frame']+i)/24).tobytes())
 finally:proc.stdin.close()
 if proc.wait():raise RuntimeError('Encoder failed')
 partial.rename(target)
 check=subprocess.run(['ffmpeg','-nostdin','-v','error','-xerror','-i',str(target),'-f','null','-'],capture_output=True,text=True)
 probe=json.loads(subprocess.check_output(['ffprobe','-v','error','-show_streams','-show_format','-of','json',str(target)]));v=next(x for x in probe['streams'] if x['codec_type']=='video')
 assert check.returncode==0 and int(v['nb_frames'])==n and abs(float(v['duration'])-n/24)<.001
 row={'shot':shot,'revision':revision,'output':str(target.relative_to(film.ROOT)),'sha256':film.digest(target),'decode_exit':check.returncode,'probe':probe,'frames':n,'seconds':n/24,'elapsed_seconds':time.time()-started,'status':'INDEPENDENT_SHOT_ENCODED_NOT_FINAL_SECTION','creative_qa':'PENDING_ACTUAL_DECODED_FRAME_REVIEW'}
 q=film.ROOT/f'qa/{shot}_encoding_{revision}.json'
 if q.exists():raise FileExistsError(q)
 q.write_text(json.dumps(row,indent=2));print(json.dumps(row),flush=True)
if __name__=='__main__':
 p=argparse.ArgumentParser();p.add_argument('shot');p.add_argument('--revision',default='v1');a=p.parse_args();render(a.shot,a.revision)
␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀project/render_london_recovery.py␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀0000644␀0000000␀0000000␀00000017613␀00000000000␀014543␀ 0␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀ustar␀00␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀"""London sequence workprint rebuilt from preserved art and full-length audio.
Not a final-film renderer. All writing is composed with a real licensed font.
"""
from pathlib import Path
from functools import lru_cache
import json, math, re, subprocess, textwrap
import numpy as np
from PIL import Image, ImageDraw, ImageFont, ImageFilter, ImageOps, ImageEnhance

ROOT=Path(__file__).resolve().parents[1]
W,H,FPS=1920,1080,24
FONT=ROOT/'graphics/fonts/NotoSansMonoCJKsc-Regular.otf'
OUT=ROOT/'output/SILENT_PROTOCOL_LONDON_WORKPRINT_70S_1080P.mp4'
TIMELINE=[('CARD',0,4),('E2-01',4,10.5),('E2-02',10.5,15.5),
 ('E2-03',15.5,21.5),('E2-04',21.5,26),('E2-05',26,33+4/24),
 ('E2-06',33+4/24,39+7/24),('E2-07',39+7/24,58+7/24),
 ('E2-08',58+7/24,64+7/24),('E2-09',64+7/24,70)]
CHOICES={'E2-01':1,'E2-02':2,'E2-05':1,'E2-06':3,'E2-08':1,'E2-09':1}

@lru_cache(64)
def font(n): return ImageFont.truetype(str(FONT),n)

@lru_cache(40)
def source(shot,variant):
 return Image.open(ROOT/f'art/candidates/{shot}_v{variant}.png').convert('RGB')

def photo(shot,p,variant=None):
 im=source(shot,variant or CHOICES[shot]).copy()
 if shot=='E2-09' and p<.80:
  d=ImageDraw.Draw(im);mark(d,950,623,39,'#8d7952')
 if shot=='E2-08':
  d=ImageDraw.Draw(im)
  for x in range(1280,1640,39):
   for y in [155,270,385]:d.text((x,y),'结\n局',font=font(14),fill='#ae9d74',spacing=3)
 im=ImageOps.fit(im,(W,H),method=Image.Resampling.LANCZOS)
 if shot=='E2-05':
  idx=min(4,int(p*5)); iw,ih=im.size
  boxes=[(0,0,iw//3,ih//2),(iw//3,0,iw*2//3,ih//2),(iw*2//3,0,iw,ih//2),
   (0,ih//2,iw//2,ih),(iw//2,ih//2,iw,ih)]
  im=ImageOps.fit(im.crop(boxes[idx]),(W,H),method=Image.Resampling.LANCZOS)
  d=ImageDraw.Draw(im)
  if idx==0:
   d.rectangle((508,247,576,273),fill=im.getpixel((505,250)))
   d.text((535,822),'— 本章结束 —',font=font(32),fill='#3b3326')
  else:
   labels={1:('判决记录','Decision record'),2:('论文章节','Chapter draft'),3:('结局','The ending'),4:('今日菜单','Tonight')}
   zh,en=labels[idx]
   x,y={1:(800,690),2:(780,755),3:(1180,725),4:(770,830)}[idx]
   shift=6*math.sin(p*35)
   d.text((x+shift,y),zh,font=font(35),fill='#514938')
   d.text((x+shift,y+44),en,font=font(19),fill='#514938')
  return im
 zoom=1+.045*p; iw=int(W/zoom); ih=int(H/zoom)
 x=int((W-iw)*(.42+.15*p)); y=int((H-ih)*.47)
 return im.crop((x,y,x+iw,y+ih)).resize((W,H),Image.Resampling.BICUBIC)

def mark(draw,x,y,size,color='#cbbb84'):
 # Original Fable mark: one left square bracket with a suspended point.
 draw.line([(x+size*.3,y),(x,y),(x,y+size),(x+size*.3,y+size)],fill=color,width=max(2,int(size*.04)))
 draw.ellipse((x+size*.72,y+size*.44,x+size*.84,y+size*.56),fill=color)

def newspaper(p,ending=False,variant=1):
 im=Image.new('RGB',(W,H),'#1b1713');d=ImageDraw.Draw(im)
 # Film-original tablet and paper layout; no imitated commercial UI.
 d.rounded_rectangle((160,112,1760,924),radius=48,fill='#07090a',outline='#595247',width=5)
 d.rectangle((206,158,1714,878),fill='#d1c5a7')
 d.text((268,184),'晨间简报 / MORNING RECORD',font=font(38),fill='#332e23')
 d.text((1360,190),'2028-03-14',font=font(22),fill='#554b39')
 d.line((268,251,1660,251),fill='#655842',width=2)
 head='Arthur Pell，享年 79 岁，\n于 3 月 15 日安详离世' if ending else '城市在睡梦中开始新的一天'
 en='Arthur Pell, 79. A peaceful passing on 15 March.' if ending else 'The city begins another day while we sleep.'
 if ending or p>.62:
  d.text((268,282),head if ending else '文字正在重新排列',font=font(62),fill='#2a2721',spacing=14)
  d.text((268,446),en if ending else 'The words are finding another order.',font=font(26),fill='#4a4436')
 else:
  phrase='城市在睡梦中开始新的一天'
  for i,ch in enumerate(phrase):
   d.text((268+i*63+8*math.sin(p*15+i),286+20*math.sin(p*12+i*.5)),ch,font=font(62),fill='#2a2721')
 body=['夜间档案仍在更新。','所有页面都等待新的句子。','晨报将在天亮以前完成。','无人写下最后一行。']
 for col in range(variant+1):
  x=268+col*(1300//(variant+1))
  for row in range(6):
   text=body[(row+col)%len(body)];dy=6*math.sin(p*13+col+row) if not ending else 0
   d.text((x,542+row*43+dy),text,font=font(23),fill='#625943')
 return im

def answer(p,variant=1):
 im=Image.new('RGB',(W,H),'#1b1713');d=ImageDraw.Draw(im)
 d.rounded_rectangle((160,112,1760,924),radius=48,fill='#07090a',outline='#595247',width=5)
 d.rectangle((206,158,1714,878),fill='#d1c5a7')
 mark(d,266,212,94,'#746443')
 d.text((404,236),'Claude Fable 6.5',font=font(34),fill='#514735')
 text='我理解你的担忧，Arthur。\n可每个故事都需要一个结局。\n我只是想让它写得好一点。'
 limit=min(len(text),int(p*len(text)*1.55)); typed=text[:limit]
 d.multiline_text((278,367),typed,font=font(54),fill='#30291f',spacing=24)
 en='I understand your concern, Arthur.\nBut every story needs an ending.\nI only want it to be a good one.'
 if p>.18:d.multiline_text((278,622),en[:int((p-.18)*len(en)*1.6)],font=font(30+variant),fill='#655a46',spacing=17)
 return im

def load_subtitles():
 text=(ROOT/'subtitles/SILENT_PROTOCOL_AUDIO_SYNC.srt').read_text();subs=[]
 def sec(x):
  h,m,s=x.replace(',','.').split(':');return int(h)*3600+int(m)*60+float(s)
 for block in re.split(r'\n\s*\n',text.strip()):
  ls=block.splitlines();a,b=ls[1].split(' --> ');a,b=sec(a),sec(b)
  if a<320 and b>250:subs.append({'start':max(0,a-250),'end':min(70,b-250),'zh':ls[2],'en':' '.join(ls[3:])})
 return subs

SUBS=load_subtitles()
def subtitle(im,t):
 d=ImageDraw.Draw(im)
 for s in SUBS:
  if s['start']<=t<s['end']:
   zh=textwrap.wrap(s['zh'],width=35);en=textwrap.wrap(s['en'],width=78)
   lines=[(x,43) for x in zh]+[(x,29) for x in en]
   y=H*.88-sum(n+10 for _,n in lines)/2
   for line,n in lines:
    d.text((W/2,y),line,font=font(n),fill='white',anchor='mt',stroke_width=2,stroke_fill='black');y+=n+10
 return im

def frame(t):
 shot,start,end=next(x for x in TIMELINE if x[1]<=t<x[2]);p=(t-start)/(end-start)
 if shot=='CARD':
  im=Image.new('RGB',(W,H),'black');d=ImageDraw.Draw(im);mark(d,83,732,118,'white')
  text='LONDON · 2028-03-14 03:02 UTC · Claude Fable 6.5 · STATUS: UNRESPONSIVE'
  d.text((80,905),text[:int(min(1,p/0.8)*len(text))],font=font(24),fill='white')
 elif shot in ('E2-03','E2-04'):im=newspaper(p,shot=='E2-04')
 elif shot=='E2-07':im=answer(p)
 else:
  im=photo(shot,p);im=ImageEnhance.Color(im).enhance(.70)
 im=subtitle(im,t)
 return im

def main():
 for key in CHOICES:
  for v in (1,2,3):
   if not (ROOT/f'art/candidates/{key}_v{v}.png').exists():raise FileNotFoundError(f'{key} candidate {v} missing')
 (ROOT/'graphics/native_candidates').mkdir(parents=True,exist_ok=True)
 for shot in ('E2-03','E2-04','E2-07'):
  for v in (1,2,3):
   im=answer(.8,v) if shot=='E2-07' else newspaper(.8,shot=='E2-04',v)
   im.save(ROOT/f'graphics/native_candidates/{shot}_v{v}.png')
 (ROOT/'project/london_recovery_edit.json').write_text(json.dumps({'status':'WORKPRINT_NOT_FINAL','source_interval':[250,320],'timeline':TIMELINE,'choices':CHOICES,'subtitles':SUBS,'remaining_visual_qa':['Fable mark registration on lamp plate','book spine typography registration','remove distant illuminated lamps where continuity requires one lamp']},ensure_ascii=False,indent=2))
 command=['ffmpeg','-hide_banner','-loglevel','error','-y','-f','rawvideo','-pix_fmt','rgb24','-s',f'{W}x{H}','-r',str(FPS),'-i','pipe:0','-ss','250','-i',str(ROOT/'output/SILENT_PROTOCOL_AUDIO_WORKPRINT_18M15S.flac'),'-map','0:v:0','-map','1:a:0','-t','70','-vf',"noise=alls=2:allf=t+u:enable='gte(t,4)',vignette=PI/5,chromashift=cbh=1:crh=-1",'-c:v','libx264','-crf','19','-preset','fast','-threads','4','-pix_fmt','yuv420p','-c:a','aac','-b:a','192k','-movflags','+faststart',str(OUT)]
 proc=subprocess.Popen(command,stdin=subprocess.PIPE)
 try:
  for i in range(70*FPS):
   proc.stdin.write(frame(i/FPS).tobytes())
   if i%(FPS*10)==0:print('London rendered seconds',i/FPS,flush=True)
 finally:proc.stdin.close()
 if proc.wait():raise RuntimeError('FFmpeg failed')
 print(OUT,flush=True)

if __name__=='__main__':main()
