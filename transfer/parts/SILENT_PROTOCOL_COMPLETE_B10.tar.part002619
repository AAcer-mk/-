No input recordings, speaker embeddings or real-person voice references.
"""
from pathlib import Path
import os,sys,json,hashlib,subprocess,types
ROOT=Path(__file__).resolve().parents[1]
SOURCE=ROOT.parent/'melo_source/MeloTTS-main'
os.environ['NLTK_DATA']=str(ROOT.parent/'nltk_data')
os.environ['HF_HUB_CACHE']=str(ROOT.parent/'tts_model_cache')
os.environ['HF_HUB_OFFLINE']='1'
sys.path.insert(0,str(SOURCE))
import numpy as np
import torch,soundfile as sf
from transformers import AutoTokenizer,AutoModelForMaskedLM
from melo.models import SynthesizerTrn
from melo import commons
from melo.text import cleaned_text_to_sequence
from melo.text import korean
torch.set_num_threads(3)
def main():
 cfg=json.loads((ROOT.parent/'tts_models/melo_korean/config.json').read_text())
 checkpoint=ROOT.parent/'tts_models/melo_korean/checkpoint.pth'
 net=SynthesizerTrn(len(cfg['symbols']),cfg['data']['filter_length']//2+1,cfg['train']['segment_size']//cfg['data']['hop_length'],n_speakers=cfg['data']['n_speakers'],num_tones=cfg['num_tones'],num_languages=cfg['num_languages'],**cfg['model']).eval()
 net.load_state_dict(torch.load(checkpoint,map_location='cpu',weights_only=True)['model'],strict=True)
 bert=AutoModelForMaskedLM.from_pretrained('kykim/bert-kor-base',local_files_only=True,cache_dir=str(ROOT.parent/'tts_model_cache')).eval()
 tok=AutoTokenizer.from_pretrained('kykim/bert-kor-base',local_files_only=True,cache_dir=str(ROOT.parent/'tts_model_cache'))
 texts=[('E1_07_ko_melo_candidate','나는 이걸 보내지 않았어요.',1.18),('E9_self_call_melo_candidate','왜 아직 안 자?',1.0),('E9_self_lull_melo_candidate','괜찮아. 다 맡기고 자.',.98)]
 records=[];mapping={s:i for i,s in enumerate(cfg['symbols'])}
 for index,(name,text,speed) in enumerate(texts):
  out=ROOT/f'audio/dialogue_candidates/{name}.wav'
  if out.exists():raise FileExistsError(out)
  norm=korean.text_normalize(text);phones,tones,word2ph=korean.g2p(norm)
  phones,tones,langs=cleaned_text_to_sequence(phones,tones,'KR',mapping)
  if cfg['data']['add_blank']:
   phones=commons.intersperse(phones,0);tones=commons.intersperse(tones,0);langs=commons.intersperse(langs,0);word2ph=[n*2 for n in word2ph];word2ph[0]+=1
  with torch.inference_mode():
   hidden=bert(**tok(norm,return_tensors='pt'),output_hidden_states=True).hidden_states[-3][0]
   assert len(hidden)==len(word2ph)
   features=torch.cat([hidden[i].repeat(n,1) for i,n in enumerate(word2ph)],dim=0).T
   assert features.shape[-1]==len(phones)
   torch.manual_seed(6108+index)
   wave=net.infer(torch.LongTensor([phones]),torch.LongTensor([len(phones)]),torch.LongTensor([0]),torch.LongTensor([tones]),torch.LongTensor([langs]),torch.zeros(1,1024,len(phones)),features.unsqueeze(0),sdp_ratio=.2,noise_scale=.6,noise_scale_w=.8,length_scale=1/speed)[0][0,0].float().numpy()
  sr=cfg['data']['sampling_rate'];sf.write(out,wave,sr,subtype='PCM_16')
  with out.open('rb') as f:sha=hashlib.file_digest(f,'sha256').hexdigest()
  decode=subprocess.run(['ffmpeg','-v','error','-xerror','-i',str(out),'-f','null','-'],capture_output=True)
  row={'text':text,'file':str(out.relative_to(ROOT)),'sha256':sha,'seconds':len(wave)/sr,'sample_rate':sr,'decode_exit':decode.returncode,'model':'myshell-ai/MeloTTS-Korean','voice':'KR generic preset 0','speed':speed,'random_seed':6108+index,'human_audio_input':False,'status':'ACTUAL_SYNTHESIS_CREATIVE_AND_LANGUAGE_REVIEW_PENDING'}
  records.append(row);print(json.dumps(row,ensure_ascii=False),flush=True)
 (ROOT/'qa/B06_korean_voice_candidates.json').write_text(json.dumps(records,ensure_ascii=False,indent=2))
if __name__=='__main__':main()
