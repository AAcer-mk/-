  },
  {
    "id": "E9-09",
    "camera_and_duration": "5s｜蒙太奇，1 秒一格",
    "source_scene": "全世界的人，在不同的房间里，接起来自自己的视频通话\n‖ 无声",
    "start_frame": 23053,
    "end_frame": 23160,
    "native": false,
    "section": "E9",
    "start": 960.5416666666666,
    "end": 965.0
