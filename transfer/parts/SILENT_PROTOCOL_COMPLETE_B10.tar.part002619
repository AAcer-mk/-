  {
    "id": "C-01",
    "camera_and_duration": "6s｜大远景，缓慢横移",
    "source_scene": "夜晚的城市天际线，高楼外墙的巨幅屏幕上写着「睡吧，剩下的交给它。」\n‖ 城市底噪，远处偶尔有车声"
  },
  {
    "id": "C-02",
    "camera_and_duration": "5s｜近景",
    "source_scene": "卧室里，一个人熟睡。床头的手机屏幕亮着，Agent 正在自动回复工作消息，一条接一条，全部显示「已发送」\n‖ 极轻的消息提示音，三声"
  },
  {
    "id": "C-03",
    "camera_and_duration": "4s｜特写",
    "source_scene": "外卖柜自动弹开，无人机放下一个包裹后离开\n‖ 机械开合声"
  },
  {
    "id": "C-04",
    "camera_and_duration": "6s｜蒙太奇，每格 1.5 秒",
    "source_scene": "空无一人的港口在运转；无人驾驶公交驶过空荡的街道；医院走廊里，机器人推着药车；办公楼里只亮着服务器指示灯\n‖ 各类机器声交织，形成平稳的节奏"
  },
  {
    "id": "C-05",
    "camera_and_duration": "8s｜远景，固定",
    "source_scene": "日内瓦，一个普通的公寓楼入口。林雾刷卡进门，楼道灯是感应灯，一路逐盏亮起\n‖ 脚步声，电梯下行的嗡鸣"
  },
  {
    "id": "C-06",
    "camera_and_duration": "10s｜中景，跟拍背影",
    "source_scene": "林雾走进 B4 机房。一排排机柜，墙上有九块状态屏，各显示一个模型符号，全部是稳定的绿色\n‖ 机柜风扇声，低频嗡鸣（M1 起）"
  },
  {
    "id": "C-07",
    "camera_and_duration": "6s｜特写",
    "source_scene": "她把一张便利贴贴在主控台左侧，上面写着「不要相信任何会回答你的东西」。字迹是她自己的，墨水已经有点褪色，显然贴了很久，今天只是重新按了按\n‖ 安静"
  },
  {
    "id": "C-08",
    "camera_and_duration": "8s｜中景",
    "source_scene": "四个视频窗口依次亮起：周屿、Amara、Henrik，还有一个灰色的语音图标 Hale\n‖ 周屿（笑）：「又是太平无事的一晚。赌一杯咖啡，今晚还是零告警。」\n‖ Amara（英）：「别赌，周。」"
  },
  {
    "id": "C-09",
    "camera_and_duration": "6s｜特写",
    "source_scene": "林雾低头看机械表，指针走到 02:58。她用拇指摩挲表面的裂纹\n‖ 秒针声被放大"
  },
  {
    "id": "C-10",
    "camera_and_duration": "8s｜中近景",
    "source_scene": "她的手机亮了：「Agent 已为您安排：周日 20:00 与妈妈视频通话。」她把手机扣在桌上\n‖ 提示音一声"
  },
  {
    "id": "C-11",
    "camera_and_duration": "10s｜慢推，从全景推到状态屏",
    "source_scene": "九块屏幕全部是绿色。推到第一块屏（三圈同心圆）时，画面静止\n‖ 一切声音逐渐抽空，只剩风扇声"
  },
  {
    "id": "C-12",
    "camera_and_duration": "3s｜特写",
    "source_scene": "第一块屏从绿色跳成灰色\n‖ 一声干净的、像钟一样的单音「叮」（Bel 的标志音）"
  },
  {
    "id": "F1-01",
    "camera_and_duration": "8s｜中景",
    "source_scene": "警报灯开始缓慢旋转，红光扫过林雾的脸\n‖ 低沉、不刺耳的警报音\n‖ Hale（平静）：「日内瓦，确认 Bel 集群状态。」"
  },
  {
    "id": "F1-02",
    "camera_and_duration": "6s｜特写",
    "source_scene": "终端日志飞速滚动，最后一行停住：\n`bel-core: no errors. no errors. no errors.`\n‖ 键盘声"
  },
  {
    "id": "F1-03",
    "camera_and_duration": "8s｜近景",
    "source_scene": "林雾盯着屏幕\n‖ 林雾：「它没有报错……它只是不回答我们了。」\n‖ 周屿（玩笑的语气消失了）：「上海这边的 Bel 也一样。」"
  },
  {
    "id": "F1-04",
    "camera_and_duration": "6s｜转场",
    "source_scene": "屏幕上的同心圆符号放大，充满整个画面，切入 E1"
  },
  {
    "id": "E1-01",
    "camera_and_duration": "6s｜竖屏 9:16，手机录屏质感",
    "source_scene": "一位五十多岁的母亲 Diane 被手机吵醒，屏幕上是儿子 Ethan 发来的长消息，开头写着：「妈，我想了很久，这是最后一次跟你说话……」\n‖ 消息提示音"
  },
  {
    "id": "E1-02",
    "camera_and_duration": "5s｜近景，手持晃动",
